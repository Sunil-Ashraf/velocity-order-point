@using OrderPoint.Components.Pages.Account
@inherits LayoutComponentBase

<div class="page flex">
    <!-- Sidebar -->
    <div class="">
        <NavMenu />
    </div>

    <!-- Main Content Section -->
    <main class="flex-1 relative overflow-y-auto h-screen">
        <!-- Sticky Email Header -->
        <div class=" top-0 bg-white z-10 stickyDiv">
            <div class="flex justify-content-between align-items-center p-4 pb-0 pr-6 pt-3">
               
                <LogoContainer />

                <LogoutButton />
            </div>
        </div>

        <!-- Scrollable Content -->
        <div class="px-4 pb-8">
            <article class="content" style="padding-left: 0px !important; padding-right: 0px !important;">
                @Body
            </article>
        </div>
    </main>
</div>

<!-- Error UI -->
<div id="blazor-error-ui" class="hidden">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>