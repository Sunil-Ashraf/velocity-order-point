 @using Blazored.Toast.Services
@using OrderPoint.Components.Common

@using OrderPoint.Domain.Common
@using OrderPoint.Domain.ViewModel
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
 @rendermode InteractiveServer
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IConfiguration _configuration
@inject IJSRuntime JSRuntime

<div class="modal fade" id="EditUser_modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="viewCargoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <EditForm Model="Editusernmodel" OnValidSubmit="UpdateUser">
            <DataAnnotationsValidator />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-2xl font-semibold text-black" id="viewCargoModalLabel">Edit User</h5>
                    <button class="text-gray-500 hover:text-gray-700" data-bs-dismiss="modal"><img src="./images/close.png"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-2">
                                <label class="block text-md font-medium text-black mb-1 ">User Type</label>
                                <input type="text" disabled class="w-full px-6 py-2 rounded-full border border-[#4E4D4D] focus:outline-none mb-4 focus:ring-1 focus:ring-[#D2D2D2] valid" name="name" value="@UserType" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-2">
                                <label class="block text-md font-medium text-black mb-1 ">First Name</label>
                                <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" @bind-value="@Editusernmodel.FirstName" />

                                <ValidationMessage For="@(()=>Editusernmodel.FirstName)" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-2">
                                <label class="block text-md font-medium text-black mb-1 ">Last Name</label>
                                <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" @bind-value="@Editusernmodel.LastName" />
                                <ValidationMessage For="@(()=>Editusernmodel.LastName)" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-2">
                                <label class="block text-md font-medium text-black mb-1 ">Email</label>
                                <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" @bind-value="@Editusernmodel.EmailAddress" />
                                <ValidationMessage For="@(()=>Editusernmodel.EmailAddress)" />
                            </div>
                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" data-bs-dismiss="modal" class="rounded-full border border-[#4E4D4D] text-dark px-4 py-2 flex-grow md:flex-none text-[16px] text-center">Cancel</button>
                    <button class="bg-[#4E4D4D] d rounded-full border-black text-white border px-4 py-2  hover:bg-[#4E4D4D] flex-grow md:flex-none text-[14px] text-center">Save</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>


@code {
    [Parameter]
    public EventCallback OnUserUpdate { get; set; }
    [Parameter]
    public String CreateFor { get; set; }
    [Parameter]
    public String UserType { get; set; }  
    [Parameter]
    public String Name { get; set; }    
    [Parameter]
    public EditUseViewModel Editusernmodel { get; set; }
    SignupViewModel adminmodel = new();
   // EditUseViewModel Editusernmodel = new();
    public async Task UpdateUser()
    {

        try
        {


            var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/Updateuser";
            var resJson = JsonSerializer.Serialize(Editusernmodel);
            var content = new StringContent(resJson, System.Text.Encoding.UTF8, "application/json");
            var response = new HttpResponseMessage();// await httpClient.PostAsync($"{_configuration["API_App_URL"]}/api/Products/CreateProduct", content);
            response = await httpClient.PutAsync(apiUrl, content);

            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                toastService.ShowError("API Response is null. Possible network error or invalid URL. ");
                return;
            }
            if (response.IsSuccessStatusCode)
            {
               
                if (OnUserUpdate.HasDelegate)
                {
                    await OnUserUpdate.InvokeAsync();
                }

                await JSRuntime.InvokeVoidAsync("hideModal", "EditUser_modal");
                toastService.ShowSuccess("User has been updated successfully.");
            }

        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.Message);

        }
        finally
        {
            // if (lstProducts.Count == 0)
            // {
            //     tableLabel = "No record found.";
            // }
            StateHasChanged();
        }

    }
}
