</div>

@code {
    [Parameter]
    public string? wholesaler { get; set; }
    [Parameter]
    public bool loader { get; set; } = true;
    private string UserEmail;
    private bool IsLoading = true;
    private bool _hasRendered = false;
    private bool isMenuOpen = false;
    private ElementReference menuContainer;
    private DotNetObjectReference<object>? objRef;
    [Inject] private IJSRuntime JS { get; set; }

    AddEditWholesalerModel wholesalerModel = new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {   

        if (firstRender && !_hasRendered)
        {
            _hasRendered = true;

            var context = HttpContextAccessor.HttpContext;
            wholesalerModel = context?.Session.GetObject<AddEditWholesalerModel>("Wholesaler");

            // var wholesalerLogo = context.Session.GetString("WholesalerLogo");
             var wholesalerID = context.Session.GetString("WholesalerID");
            // var WholesalerLandingPageTelephone = context.Session.GetString("WholesalerLandingPageTelephone");
            // Safe to call JS interop/localStorage here
            await LogoutService.InitializeAsync();
            await AuthProvider.InitializeAsync();

            var isTokenValid = await AuthProvider.IsTokenValidAsync();
            if (isTokenValid)
            {
                loader = false;
                UserEmail = await AuthProvider.GetClaimValue(ClaimTypesEx.Name);
           
                //string wholesalerName = await AuthProvider.GetClaimValue("WholesalerName");

                if (wholesalerModel.Name != wholesaler)
                {
                    UserEmail = String.Empty;
                    
                    await Logout();
                }
            }
            else
            {
                UserEmail = String.Empty;
              
                loader = false;
            }
             
            StateHasChanged();
        }
    }
    public async Task GetWholesalerByID(String wholesalername)
    {

        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Wholesaler/GetWholesalerByName?name={wholesalername}";
            var response = await httpClient.GetAsync(apiUrl);
          
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Response<AddEditWholesalerModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                wholesalerModel = result?.Data ?? new AddEditWholesalerModel();
                if (string.IsNullOrEmpty(wholesalerModel.Name))
                {
                    navigator.NavigateTo("/PageNotFound");
                }
                await _localStorage.SetItemAsync("WholesalerLogo", wholesalerModel.ImagePath);
                StateHasChanged();
            }
            else
            {

                string errorDetails = await response.Content.ReadAsStringAsync();
                //toastService.ShowError(errorDetails);
            }
            loader = false;
        }
        catch (Exception ex)
        {
            loader = false;
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }

    private async Task Logout()
    {
        await _localStorage.RemoveItemAsync("authToken");
        AuthProvider.NotifyUserLogout();
        StateHasChanged();
    }
    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;

        if (isMenuOpen)
        {
            objRef = DotNetObjectReference.Create<object>(this);
            JS.InvokeVoidAsync("registerOutsideClick", menuContainer, objRef);
        }
        else
        {
            JS.InvokeVoidAsync("unregisterOutsideClick");
        }
    }

    private async void ChooseProduct()
    {
        await AuthProvider.InitializeAsync();
        var isTokenValid = await AuthProvider.IsTokenValidAsync();

        if (isTokenValid)
        {
            navigator.NavigateTo("/product-listing");
         
        }
    } 
    private async void DeliveryOption()
    {
        await AuthProvider.InitializeAsync();
        var isTokenValid = await AuthProvider.IsTokenValidAsync();
       if (isTokenValid)
        {
           string  Userrole = await AuthProvider.GetClaimValue(ClaimTypesEx.Role);
            if (Userrole.Contains(Roles.Wholesaler))
            {
                navigator.NavigateTo("/Wholesaler/deliveryOptions");
            }
        }
    }

    [JSInvokable]
    public void CloseMenu()
    {
        isMenuOpen = false;
        StateHasChanged();
    }


}