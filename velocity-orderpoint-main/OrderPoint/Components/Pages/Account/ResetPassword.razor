@page "/reset-password"
@layout OrderPoint.Components.Layout.AccountLayout

@using Blazored.LocalStorage
@using System.Text.Json
@using System.Text
@using Blazored.Toast.Services
@using OrderPoint.Components.Common
@using System.ComponentModel.DataAnnotations
@using OrderPoint.Domain.ViewModel
 @using OrderPoint.Helper
 
@inject ILocalStorageService _localStorage
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
@inject IHttpContextAccessor HttpContextAccessor
<AppToast />
@rendermode InteractiveServer
@inject IConfiguration _configuration
@inject ILocalStorageService _localStorag
<PageTitle>Order Point | Login</PageTitle>
<Loader visible=loader />
<div class="min-h-screen flex flex-col items-center justify-between bg-white py-4">

    @*     <img src="/images/Order1.png" alt="Logo" class="w-[200px] h-[75px] filter brightness-[0.5]" />
 *@    

    <img class="w-[100px]   logoOrder" style="    height: 65px;
    object-fit: contain;" src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{WholesaleLogo}")"
         onerror="this.onerror=null;this.src='/images/Order Point.png';"
         alt="Alternate Text" />

    @* else
    {

        <img src="/images/Order Point.png" class="w-[100px] h-[75px] logoOrder" alt="Alternate Text" />  
    } *@
    <div class="w-full max-w-md flex flex-col items-center px-3 px-md-0 mt-6">

        @if (IsNewUserRequest==true)
        {
            <h1 class="font-semibold text-[42px] text-[#1A1A1A] mb-8 text-center">Set Password</h1>
        }
        else{

        <h1 class="font-semibold text-[42px] text-[#1A1A1A] mb-8 text-center">Reset Password</h1>
        }



        <EditForm Model="Model" OnValidSubmit="HandleSubmit" class="w-full flex flex-col items-center ">

            <DataAnnotationsValidator />
          

            <div class="mb-4 w-full position-relative">
                @if (IsNewUserRequest == true)
                {
                    <InputText @bind-Value="Model.NewPassword"
                               class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1"
                               placeholder="Enter Password"
                              
                                type="@passwordInputType"
                               />
                    <button type="button"
                            @onclick="TogglePasswordVisibility"
                            class="absolute right-4 top-[22px] transform -translate-y-1/2 text-gray-500 focus:outline-none">
                        <i class="fas @(isPasswordVisible ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                }
                else
                {

                    <InputText @bind-Value="Model.NewPassword"
                               class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1"
                               placeholder="New Password"
                               type="@passwordInputType" 
                               />
                    <button type="button"
                            @onclick="TogglePasswordVisibility"
                            class="absolute right-4 top-[22px] transform -translate-y-1/2 text-gray-500 focus:outline-none">
                        <i class="fas @(isPasswordVisible ? "fa-eye-slash" : "fa-eye")"></i>
                    </button>
                }
      
                <ValidationMessage For=@(()=>Model.NewPassword) class="text-danger" />
            </div>
            <div class="mb-4 w-full position-relative">
                <InputText @bind-Value="Model.ConfirmPassword"
                           class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1"
                           placeholder="Confirm Password"
                           type="@confirmPasswordInputType" 
                           />
                <button type="button"
                        @onclick="ToggleConfirmPasswordVisibility"
                        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 focus:outline-none">
                    <i class="fas @(isConfirmPasswordVisible ? "fa-eye-slash" : "fa-eye")"></i>
                </button>
                <ValidationMessage For=@(()=>Model.ConfirmPassword) class="text-danger" />
            </div>



            <button type="submit"
                    class="bg-[#4E4D4D] mb-4 text-white font-semibold w-full h-[45px] rounded-full px-6 py-2 hover:bg-[#4E4D4D]">
                Reset Password
            </button>
            <div>
                <a href="/login" class="text-[#1A1A1A] hover:text-[#1A1A1A] font-semibold text-decoration-none"> <i class="fa fa-arrow-left pe-1"></i> Back To Login</a>
            </div>
        </EditForm>
    </div>

    <div class="mt-10">
        <p class="font-[Inter] font-normal text-dark text-base leading-6 tracking-normal text-center">
            Copyright © Order Point @DateTime.Now.Year
        </p>
    </div>
</div>

@code {
    [Parameter]
    public String email { get; set; }
    [Parameter]
    public string token { get; set; }
    [Parameter]
    public bool IsNewUserRequest { get; set; }
    [Parameter]
    public string whlogo { get; set; }
    [Parameter]
    public string wholerID { get; set; }
    [Parameter]
    public string ReturnUrl { get; set; }

    [Parameter]
    public bool loader { get; set; } = true;

    public string WholesaleLogo { get; set; }
    public string WholesaleID { get; set; }

    private ResetPasswordViewModel Model = new();
    protected override void OnInitialized() => Model ??= new();
    AddEditWholesalerModel wholesalerModel = new();

    private bool isPasswordVisible = false;
    private bool isConfirmPasswordVisible = false;
    private string passwordInputType => isPasswordVisible ? "text" : "password";

    private string confirmPasswordInputType => isConfirmPasswordVisible ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        isConfirmPasswordVisible = !isConfirmPasswordVisible;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = new Uri(navigator.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            email = query["email"];
            token = query["token"];
            WholesaleLogo = query["whlogo"];
            WholesaleID = query["wholerID"];
            IsNewUserRequest = !String.IsNullOrEmpty(query["IsNewUserRequest"]) && Convert.ToBoolean(query["IsNewUserRequest"]) ? Convert.ToBoolean(query["IsNewUserRequest"]) :false;
            string WholesLogo = await _localStorage.GetItemAsync<string>("WholesalerLogo");

            if (!string.IsNullOrEmpty(token))
            {

                if (!string.IsNullOrEmpty(WholesaleLogo))
                {
                   // WholesaleLogo = WholesaleLogo;
                    //await GetWholesalerByID(WholesaleID);
                    await _localStorage.SetItemAsync("WholesalerLogo", WholesaleLogo);
                }
                else
                {
                    await _localStorage.SetItemAsync("WholesalerLogo", wholesalerModel.ImagePath);

                }


                Model.Email = email;
                Model.Token = token;
                loader = false;
            }
            else
            {
                navigator.NavigateTo("/login");
            }
            StateHasChanged();
        }
    }
    public async Task GetWholesalerByID(String WholesaleID)
    {

        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Wholesaler/GetWholesalerByID?Id={WholesaleID}";
            var response = await httpClient.GetAsync(apiUrl);

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Response<AddEditWholesalerModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                wholesalerModel = result?.Data ?? new AddEditWholesalerModel();

                await _localStorage.SetItemAsync("WholesalerLogo", wholesalerModel.ImagePath);
                StateHasChanged();
            }
            else
            {

                string errorDetails = await response.Content.ReadAsStringAsync();
                //toastService.ShowError(errorDetails);
            }
            loader = false;
        }
        catch (Exception ex)
        {
            loader = false;
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }
    private async void HandleSubmit()
    {
        loader = true;
        StateHasChanged();

        try
        {
            var jsonContent = new StringContent(JsonSerializer.Serialize(Model), Encoding.UTF8, "application/json");
            var res = await httpClient.PostAsync(_configuration["API_App_URL"] + "/api/Account/reset-password", jsonContent);
            if (res.IsSuccessStatusCode)
            {
                var jsonString = await res.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<OrderPoint.Domain.Common.APIResponse>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (result.Success)
                {
                    Model = new();
                    toastService.ShowSuccess(result.Message);
                }
                else
                {
                    toastService.ShowError(result.Message);
                }
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error : {ex.Message}");
        }
        finally
        {
            loader = false;
            StateHasChanged();
        }
    }

    public class ForgotPasswordModel
    {
        public string Email { get; set; }
    }
}
