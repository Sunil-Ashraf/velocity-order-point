@using OrderPoint.Services
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager NavManager
@using System.Security.Claims
@using OrderPoint.Helper
@using Blazored.LocalStorage
@inject ILocalStorageService _localStorage
@rendermode InteractiveServer
@using OrderPoint.Domain.ViewModel
@inject IConfiguration _configuration
@inject IHttpContextAccessor HttpContextAccessor
<div class="divLogo">
    @if (_hasRendered && isWholesaler && !isProductListingPage)
    {


        @if (!string.IsNullOrEmpty(WholesaleLogo))
        {
            <img class="w-[100px] ms-5  logoOrder" style="    height: 65px;
    object-fit: contain;" src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{WholesaleLogo}")"
            onerror="this.onerror=null;this.src='/images/Order Point.png';"
            alt="Alternate Text" />
        }
        else
        {
            <img src="/images/Order1.png"
            class="w-[160px] h-[60px] object-contain filter brightness-[0.5] ms-5"
            alt="Logo" />
            @* <img src="/images/Order Point.png" class="w-[100px] h-[75px] logoOrder" alt="Alternate Text" /> *@
        }
    }


</div>

@code {
    private bool _hasRendered = false;
    private bool isWholesaler = false;
    private string role = "";
    private bool isProductListingPage = false;
    public string WholesaleLogo { get; set; }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRendered)
        {
            _hasRendered = true;

            await AuthProvider.InitializeAsync();
            role = await AuthProvider.GetClaimValue(ClaimTypesEx.Role);

            var context = HttpContextAccessor.HttpContext;
            var wholesalerModel = context?.Session.GetObject<AddEditWholesalerModel>("Wholesaler");
            if (wholesalerModel != null)
            {
                WholesaleLogo = wholesalerModel.ImagePath;
            }
            //await _localStorage.GetItemAsync<string>("WholesalerLogo");
            if (role.Contains(Roles.Wholesaler))
            {
                isWholesaler = true;
            }

            // Check initial path
            CheckPath();

            // Listen for navigation changes
            NavManager.LocationChanged += (_, __) =>
            {
                CheckPath();
                InvokeAsync(StateHasChanged);
            };

            StateHasChanged();
        }
    }

    private void CheckPath()
    {
        var uri = NavManager.Uri.ToLower();
        isProductListingPage = uri.Contains("/product-listing");
    }
}
