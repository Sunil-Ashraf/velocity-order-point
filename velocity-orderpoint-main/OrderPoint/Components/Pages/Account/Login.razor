@page "/login"
@layout OrderPoint.Components.Layout.AccountLayout
@using Blazored.LocalStorage
@using System.Text.Json
@using System.Text
@using Blazored.Toast.Services
@using OrderPoint.Domain.ViewModel
@using OrderPoint.Services
@using Microsoft.AspNetCore.Components.Authorization
@using OrderPoint.Components.Common
@using OrderPoint.Helper
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
@inject JwtAuthenticationStateProvider AuthProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject ILocalStorageService _localStorage

@using System.Security.Claims;

<AppToast />
<Loader visible=loader />
@rendermode InteractiveServer
@inject IConfiguration _configuration

<div class="min-h-screen flex flex-col items-center justify-content-between bg-white py-4">

    <!-- Logo -->
    @*     <img src="/images/Order1.png" alt="Logo" class="w-[200px] h-[75px] filter brightness-[0.5]" />
 *@
    @if (!string.IsNullOrEmpty(WholesaleLogo))
    {
        <img class="w-[100px]   logoOrder" style="    height: 65px;
    object-fit: contain;" src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{WholesaleLogo}")"
        onerror="this.onerror=null;this.src='/images/Order Point.png';"
        alt="Alternate Text" />
    }
    else
    {

        <img src="/images/Order Point.png" class="w-[100px] h-[75px] logoOrder" alt="Alternate Text" />
    }
    <!-- Login Form Container -->
    <div class="w-full max-w-md flex flex-col items-center px-3 px-md-0">

        <!-- Title -->
        <h1 class="font-semibold text-[42px] text-[#1A1A1A] mb-8">Log in</h1>

        <!-- Form -->
        <EditForm Model="Model" OnValidSubmit="Submit" FormName="LoginForm" class="w-full flex flex-col items-center gap-2">
            <DataAnnotationsValidator />
            <!-- Email or Phone -->
            <div class="mb-4 w-full">
                <InputText @bind-Value="Model.Email" placeholder="Email or phone"
                class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1" />
                <ValidationMessage For=@(()=>Model.Email) class="text-danger" />
            </div>
            <!-- Password -->
            <div class=" w-full relative">

                <InputText @bind-Value="Model.Password"
                type="@passwordInputType"
                placeholder="Password"
                class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 pr-12" />

                <button type="button"
                @onclick="TogglePasswordVisibility"
                class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 focus:outline-none">
                    <i class="fas @(isPasswordVisible ? "fa-eye-slash" : "fa-eye")"></i>
                </button>

            </div>
            <div class="text-start w-100"><ValidationMessage For="@(() => Model.Password)" class="text-danger mt-0" /></div>


            <!-- Remember Me and Forgot Password -->
            <div class="w-full flex justify-between items-center text-sm text-[#1A1A1A] px-2 mb-4">
                <label class="flex items-center gap-2">
                    <input type="checkbox" @bind="Model.RememberMe"
                    class="transform scale-125 text-[#1A1A1A] accent-[#1A1A1A]" />
                    Remember Me
                </label>

                <a href="/forgot-password" class="text-[#1A1A1A] hover:text-[#1A1A1A] hover:underline">Forgot Password?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" disabled="@loader"
            class="bg-[#4E4D4D] text-white font-semibold w-full h-[45px] rounded-full mb-4 px-6 py-2 hover:bg-[#4E4D4D] relative">
                <span class="@(loader ? "invisible" : "")">LOG IN</span>
                @if (loader)
                {
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-white"></div>
                    </div>
                }
            </button>
            <div>
                <a href="/" class="text-[#1A1A1A] hover:text-[#1A1A1A] font-semibold text-decoration-none"> <i class="fa fa-arrow-left pe-1"></i> Back To Home</a>
            </div>
        </EditForm>
    </div>
    <div class="">
        <p class="font-[Inter] font-normal text-base text-dark leading-6 tracking-normal">
            Copyright © Order Point @DateTime.Now.Year 
        </p>
    </div>
</div>

@code {
    private bool isPasswordVisible = false;
    private string passwordInputType => isPasswordVisible ? "text" : "password";

    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }

    [Parameter]
    public bool loader { get; set; } = false;
    [Parameter]
    public string ReturnUrl { get; set; }
    public string WholesaleLogo { get; set; }
    public Int32 WholesaleeID { get; set; }
    public OrderPoint.Domain.ViewModel.LoginViewModel Model { get; set; }

    private string Userrole;
    protected override void OnInitialized() => Model ??= new();
    private bool _hasRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRendered)
        {
            loader = true;
            _hasRendered = true;

            var context = HttpContextAccessor.HttpContext;
            var  wholesalerModel = context?.Session.GetObject<AddEditWholesalerModel>("Wholesaler");

            await AuthProvider.InitializeAsync();

            //var authState = await AuthProvider.GetAuthenticationStateAsync();
            var isTokenValid = await AuthProvider.IsTokenValidAsync();
            if(wholesalerModel!= null){

                WholesaleLogo = wholesalerModel.ImagePath;//await _localStorage.GetItemAsync<string>("WholesalerLogo");
                WholesaleeID = Convert.ToInt32(wholesalerModel.ID);
            }
            //var user = authState.User;
            // if (user.Identity.IsAuthenticated)

            var claimwholesalerID = await AuthProvider.GetClaimValue("WholesalerID");
            Int32 clamWsalerID;
            if (!String.IsNullOrEmpty(claimwholesalerID))
            {
                clamWsalerID = Convert.ToInt32(claimwholesalerID);
            }
            else{
                clamWsalerID = WholesaleeID;
            }
            //if (isTokenValid && clamWsalerID == WholesaleeID)
            if (isTokenValid )
            {
                Userrole = await AuthProvider.GetClaimValue(ClaimTypesEx.Role);
              

                if (Userrole.Contains(Roles.Wholesaler))
                {

                    navigator.NavigateTo("/products");

                }
                else
                {
                    navigator.NavigateTo("/product-listing");
               
                }
            }
            loader = false;
            StateHasChanged();
        }
    }
    private async Task Submit()
    {
        loader = true;
        StateHasChanged();

        try
        {
            Model.IsCustomerPortal = true;
            Model.WholesalerID = WholesaleeID;
            var jsonContent = new StringContent(JsonSerializer.Serialize(Model), Encoding.UTF8, "application/json");
            var res = await httpClient.PostAsync(_configuration["API_App_URL"] + "/api/Account/Login", jsonContent);
            if (res.IsSuccessStatusCode)
            {
                var jsonString = await res.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<APIResponse>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (result.Success)
                {
                    await AuthProvider.InitializeAsync();
                    await _localStorage.SetItemAsync("authToken", result.Message);
                    Userrole = await AuthProvider.GetClaimValue(ClaimTypesEx.Role);

                    var id= await _localStorage.GetItemAsync<string>("LoginUserID");
                    var userId = await AuthProvider.GetClaimValue(ClaimTypes.NameIdentifier);

                    await _localStorage.SetItemAsync("LoginUserID", userId);
                    if (String.IsNullOrEmpty(id))
                    {
                        await _localStorage.SetItemAsync("LoginUserID", userId);
                        List<ProductsViewModel> lst = new List<ProductsViewModel>();
                        await _localStorage.SetItemAsync("CartItemList", lst);
                    }
                    else{
                        await _localStorage.SetItemAsync("LoginUserID", userId);
                        long.TryParse(userId, out long parsedUserID);
                        long.TryParse(id, out long parsedID);
                        if (parsedUserID != parsedID)
                        {
                            List<ProductsViewModel> lst = new List<ProductsViewModel>();
                            await _localStorage.SetItemAsync("CartItemList", lst);
                        }
                    }


                    if (Userrole.Contains(Roles.Wholesaler))
                    {

                        navigator.NavigateTo("/products");

                    }
                    else{
                        navigator.NavigateTo("/product-listing");
                       // navigator.NavigateTo("/Customer-product-listing");
                    }

                    // Force reload to apply auth
                }
                else
                {
                    toastService.ShowError(result.Message);
                }
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error updating supplier data: {ex.Message}");
        }
        finally
        {
            loader = false;
            StateHasChanged();
        }
    }
}