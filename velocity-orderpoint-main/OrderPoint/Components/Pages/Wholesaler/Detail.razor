@page "/view-details"


@using Blazored.Toast.Services
@using OrderPoint.Components.Common
@using OrderPoint.Components.Pages.Customer
@using OrderPoint.Domain.Common
@using OrderPoint.Domain.ViewModel
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text
@using OrderPoint.Helper
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
@rendermode InteractiveServer
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IConfiguration _configuration
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
 
<PageTitle>Order Point | Wholesaler List</PageTitle>
<Loader visible=loader />
<AppToast />
<Auth setAuth="@setAuth" />
<div class="min-h-screen mt-3">
    <div class="">
        <div class="">
            <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
                <div class="text-2xl font-semibold text-black">
                    Details
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center justify-content-end">
                    <div class="position-relative">
                        <input type="search" placeholder="Search" class="w-full px-6 py-2 rounded-full  focus:outline-none" @bind="search" @oninput="OnSearchChanged" />
                        @if (string.IsNullOrWhiteSpace(search))
                        {

                            <span class="position-absolute top-[8px] right-[13px] text-[#ffffff]">
                                <i class="fa fa-search"></i>
                            </span>
                        }
                    </div>
                   
                </div>
            </div>
            <div class=" rounded-[0.9rem] border table-responsive ">
                <table class="table-auto  w-full    text-left text-sm ">
                    <thead class="text-sm font-medium    text-black bg-[#F7F7F7] ">
                        <tr>

                            <th class="px-4 py-2  "  >
                                <button class="flex items-center space-x-1">
                                    <span> Logo </span>
                                    @* <i class="bi bi-arrow-up @(customerSortColumn == nameof(WholesalerViewModel.Status) && isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down @(customerSortColumn == nameof(WholesalerViewModel.Status) && !isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;">< /i>*@
                                </button>
                            </th>
                            <th class="px-4 py-2" @onclick="() => SortTable(nameof(WholesalerViewModel.Name))">
                                <button class="flex items-center space-x-1">
                                    <span>  Name </span>
                                    <i class="bi bi-arrow-up @(wholesalerSortColumn == nameof(WholesalerViewModel.Name) && isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down @(wholesalerSortColumn == nameof(WholesalerViewModel.Name) && !isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2" @onclick="() => SortTable(nameof(WholesalerViewModel.RandID))">
                                <button class="flex items-center space-x-1">
                                    <span> Unique Ref# </span>
                                    <i class="bi bi-arrow-up @(wholesalerSortColumn == nameof(WholesalerViewModel.RandID) && isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down @(wholesalerSortColumn == nameof(WholesalerViewModel.Status) && !isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2" @onclick="() => SortTable(nameof(WholesalerViewModel.NoOfUser))">
                                <button class="flex items-center space-x-1">
                                    <span class="flex items-center text-nowrap"> No.Of Users </span>
                                    <i class="bi bi-arrow-up @(wholesalerSortColumn == nameof(WholesalerViewModel.NoOfUser) && isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down @(wholesalerSortColumn == nameof(WholesalerViewModel.NoOfUser) && !isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2" @onclick="() => SortTable(nameof(WholesalerViewModel.Status))">
                                <button class="flex items-center space-x-1">
                                    <span class="flex items-center text-nowrap"> Status </span>
                                    <i class="bi bi-arrow-up @(wholesalerSortColumn == nameof(WholesalerViewModel.Status) && isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down @(wholesalerSortColumn == nameof(WholesalerViewModel.Status) && !isAscending ? "text-black font-bold" : "text-gray-400")" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>

                            <th class="px-4 py-2">
                                <div class="flex  justify-center">
                                    Actions
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white  p-4 mb-6 text-sm font-normal text-black">
                        @if (lstwholesaler.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center">No record found.</td></tr>
                        }
                        else
                        {
                            foreach (var item in lstwholesaler)
                            {
                                <tr>


                                    <td class="px-4 py-2">
                                        <div>

                                            <img src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{item.ImagePath}")"
                                            onerror="this.onerror=null;this.src='./images/PlaceHolder.png';"
                                            style="width:70px;height:35px" alt="Alternate Text" />



                                        </div>
                                    </td>
                                    <td class="px-4 py-2">@item.Name</td>
                                    <td class="px-4 py-2">@item.RandID</td>
                                    <td class="px-4 py-2">@item.NoOfUser</td>
                                    <td class="px-4 py-2">@item.Status</td>
                                    <td class="px-4 py-2">
                                        <div class="d-flex align-items-center justify-content-center gap-2">

                                            <!-- Visible Action Buttons -->
                                            <a href="javscript:;" @onclick="()=>GetWholesSalerUsersList(item.ID,item.Name)" class="text-secondary me-2" title="View Users">
                                                <i class="bi bi-eye-fill fs-5"></i>
                                            </a>

                                            <a href="javscript:;" class="text-secondary me-2" @onclick="()=>AddUser(item.ID,item.Name)" title="Add New User"><i class="fa fa-plus fs-6"></i></a>

                                            <a class="text-secondary" href="/view-details/edit-details/@item.ID" title="Edit">
                                                <span><i class="fa fa-pencil"></i></span>
                                            </a>

                                            @* <a class="text-secondary" href="/edit-details" title="Delievery Options">
                                                <i class="fa-solid fa-truck-ramp-box"></i>
                                            </a> *@



                                        </div>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="flex justify-center items-center  mt-4">
                <!-- Previous Button -->
                <button @onclick="PreviousPage" disabled="@(WholesalerPageNumber == 1)"
                class="px-2 py-[0.7rem] border rounded-md bg-white text-myblueGray hover:bg-gray-200 disabled:opacity-50">
                    <img src="./images/back.png" alt="Previous" />
                </button>

                <!-- Page Numbers -->
                @for (int i = 1; i <= WholesalerTotalPages; i++)
                {
                    int currentPage = i; // Create a local copy of i

                    if (currentPage == 1 || currentPage == 2 || currentPage == WholesalerTotalPages - 1 || currentPage == WholesalerTotalPages)
                    {
                        <!-- Always show first two and last two pages -->
                        <button @onclick="() => ChangePage(currentPage)"
                        class="px-3 py-1 border rounded-md bg-white hover:bg-gray-200 @(WholesalerPageNumber == currentPage ? "bg-gray-100 font-bold" : "")">
                            @currentPage
                        </button>
                    }
                    else if (currentPage >= WholesalerPageNumber - 1 && currentPage <= WholesalerPageNumber + 1)
                    {
                        <button @onclick="() => ChangePage(currentPage)"
                        class="px-3 py-1 border rounded-md bg-white hover:bg-gray-200 @(WholesalerPageNumber == currentPage ? "bg-gray-100 font-bold" : "")">
                            @currentPage
                        </button>
                    }
                    else if ((currentPage == 3 && WholesalerPageNumber > 4) || (currentPage == WholesalerTotalPages - 2 && WholesalerPageNumber < WholesalerTotalPages - 3))
                    {
                        <span class="px-3 py-1 bg-white">...</span>
                    }
                }

                <!-- Next Button -->
                <button @onclick="NextPage" disabled="@(WholesalerPageNumber == WholesalerTotalPages)"
                class="px-2 py-[0.7rem] border rounded-md bg-white hover:bg-gray-200 disabled:opacity-50">
                    <img src="./images/next.png" alt="Next" />
                </button>
            </div>
        </div>
    </div>
    <div class="modal fade" id="ViewUerModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="viewCargoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-2xl font-semibold text-black" id="viewCargoModalLabel">Users for @WholesalerName</h5>
                    <button class="text-gray-500 hover:text-gray-700" data-bs-dismiss="modal"><img src="./images/close.png"></button>
                </div>
                <div class="modal-body">
                    <div class="overflow-x-auto rounded-[0.9rem] border">
                        <table class="table-auto  w-full    text-left text-sm ">
                            <thead class="text-sm font-medium    text-black bg-[#F7F7F7] ">
                                <tr>
                                    <th class="px-4 py-2">
                                        <button class="flex items-center space-x-1">
                                            <span class="text-nowrap flex items-center ">
                                                Username
                                            </span>
                                            <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                            <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                        </button>
                                    </th>
                                    <th class="px-4 py-2  ">
                                        <button class="flex items-center space-x-1">
                                            <span> Email </span>
                                            <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                            <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                        </button>
                                    </th>
                                    <th class="px-4 py-2">
                                        <button class="flex items-center space-x-1">
                                            <span> BCC To Order Emails </span>
                                            <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                            <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                        </button>
                                    </th>

                                </tr>
                            </thead>
                            <tbody class="bg-white  p-4 mb-6 text-sm font-normal text-black">
                                @if (wholesalerUserList.Count() > 0)
                                {
                                    foreach (var item in wholesalerUserList)
                                    {

                                        <tr>
                                            <td class="px-4 py-2">@item.FirstName @item.LastName</td>
                                            <td class="px-4 py-2">@item.Email</td>

                                            @if (item.IsBCCToOrderEmail.HasValue && item.IsBCCToOrderEmail.Value==true){
                                                <td class="px-4 py-2">Yes</td>
                                            }
                                            else{
                                                <td class="px-4 py-2">No</td>
                                            }




                                        </tr>

                                    }
                                }
                                else{
                                    <tr>
                                        <td colspan="4" class="text-center">No record found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button data-bs-dismiss="modal" class="rounded-full border border-[#4E4D4D] text-dark px-4 py-2 flex-grow md:flex-none text-[16px] text-center">Cancel</button>
                    <button class="bg-[#4E4D4D] rounded-full border-black text-white border px-4 py-2 hover:bg-[#4E4D4D] flex-grow md:flex-none text-[14px] text-center">Save</button>
                </div>
            </div>
        </div>
    </div>
    <AddUser OnUserUpdate="GetAllWholesalerList" UserType="@Roles.Wholesaler" Name="@WholesalerName" CreateFor="@Roles.Wholesaler" CustomerID="0" WholesalerID="@WholesalerID" />
</div>

@code {
    [Parameter]
    public bool loader { get; set; } = false;

    public String WholesalerName { get; set; }
    public long WholesalerID { get; set; }


    SignupViewModel adminmodel = new();
    private bool isAuthenticated;
    private void setAuth(bool val)
    {
        if (val)
        {
            isAuthenticated = val;
            StateHasChanged();
        }
        else
        {
            navigator.NavigateTo("/login", true);
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        loader = true;
        if (firstRender)
        {
            string msg = NotificationService.SuccessMessage;
            if (msg != null)
            {
                toastService.ShowSuccess(msg);
                NotificationService.SuccessMessage = null;
            }
            string token = await _localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
              
                httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                await GetAllWholesalerList();
            }
            else
            {
                navigator.NavigateTo("/login");
            }

        }
    }
    public class PagerResponse<T>
    {
        public int totalRecords { get; set; }
        public int pageNumber { get; set; }
        public int pageSize { get; set; }
        public List<T> data { get; set; }
    }

    private List<WholesalerViewModel> lstwholesaler = new();
    private System.Timers.Timer _debounceTimer;
    private List<UserDetail> wholesalerUserList = new();
    // Product Pagination
    private int pageSize = 10;
    private int WholesalerPageNumber = 1;
    private int WholesalerTotalPages = 1;
    private string wholesalerSortColumn = "Name";
    private string sortOrder = "asc";
    private string search = string.Empty;
    EditUseViewModel Editusernmodel = new();

    private async Task GetAllWholesalerList()
    {
        // tableLabel = "Loading...";
        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Wholesaler/GetWholesalerbyUserID?pageNumber={WholesalerPageNumber}&pageSize={pageSize}&sortColumn={wholesalerSortColumn}&sortOrder={sortOrder}&search={search}";
            // Make the API call
            var response = await httpClient.GetAsync(apiUrl);
            loader = false;
            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<PagerResponse<WholesalerViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                lstwholesaler = result?.data ?? new List<WholesalerViewModel>();
                WholesalerTotalPages = result?.totalRecords > 0 ? (int)Math.Ceiling((double)result.totalRecords / pageSize) : 0;
            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ API Response: {response.StatusCode}");
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Console.WriteLine("❌ 404 Not Found: The requested resource was not found.");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    Console.WriteLine("❌ 401 Unauthorized: Token is invalid or expired.");
                    await _localStorage.RemoveItemAsync("authToken");
                    navigator.NavigateTo("/login");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in GetProductData: {ex.Message}");
        }
    }
    private async Task NextPage()
    {
        if (WholesalerPageNumber < WholesalerPageNumber)
        {
            WholesalerPageNumber++;
            await GetAllWholesalerList();
        }
    }
    private async Task PreviousPage()
    {
        if (WholesalerPageNumber > 1)
        {
            WholesalerPageNumber--;
            await GetAllWholesalerList();
        }
    }
    private async Task ChangePage(int page)
    {
        WholesalerPageNumber = page;
        await GetAllWholesalerList();
    }

    private bool isAscending = true;

    private async Task SortTable(string columnName)
    {
        if (wholesalerSortColumn == columnName)
        {
            isAscending = !isAscending;
        }
        else
        {
            wholesalerSortColumn = columnName;
            isAscending = true;
        }

        if (isAscending)
        {
            sortOrder = "asc";
        }
        else
        {
            sortOrder = "desc";
        }
        await GetAllWholesalerList();
    }
    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        string currentSearch = e.Value?.ToString();
        //   private System.Timers.Timer _debounceTimer;
        _debounceTimer?.Stop();
        _debounceTimer = new System.Timers.Timer(800);
        _debounceTimer.Elapsed += async (sender, args) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                search = currentSearch;
                await GetAllWholesalerList();
                StateHasChanged();
            });
        };
        _debounceTimer.Start();
        // search = e.Value?.ToString() ?? "";
        // await Task.Delay(2000); // 2-second delay
        // await GetAllWholesalerList();
    }




    private async Task AddUser(long wholesalerid, String name)
    {
       
        WholesalerName = name;
        WholesalerID = wholesalerid;
        await JSRuntime.InvokeVoidAsync("hideModal", "ViewUerModal");
        
        await JSRuntime.InvokeVoidAsync("showModal", "addUser_modal");
        loader = false;
    }
    public async Task GetUserByID(long userID)
    {

        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/GetAdminByID?userID={userID}";
            var response = await httpClient.GetAsync(apiUrl);

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Response<EditUseViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                Editusernmodel = result?.Data ?? new EditUseViewModel();
                // adminmodel.IsEdit = true;
                await JSRuntime.InvokeVoidAsync("showModal", "EditUser_modal");
                await JSRuntime.InvokeVoidAsync("hideModal", "ViewUerModal");
                //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();
          
            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                toastService.ShowError(errorDetails);
            }
            loader = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            loader = false;
            toastService.ShowError(ex.Message);
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }
    public async Task DeleteUser(long userID)
    {

        try
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("ShowConfirmSwal", "Are you sure?", "Do you want to delete this item?", "warning");
            if (confirmed)
            {
                var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/Removeuser?userID={userID}&isDeleleUserForWholesaler={true} ";
                var response = await httpClient.GetAsync(apiUrl);

                if (response.IsSuccessStatusCode)
                {
                    var jsonString = await response.Content.ReadAsStringAsync();

                    var result = JsonSerializer.Deserialize<Response<SignupViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    adminmodel = result?.Data ?? new SignupViewModel();


                    adminmodel.ConfirmEmailAddress = adminmodel.EmailAddress;

                    await JSRuntime.InvokeVoidAsync("hideModal", "ViewUerModal");
                    toastService.ShowSuccess("User has been Deleted successfully.");
                    
                    //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();

                }
                else
                {
                    string errorDetails = await response.Content.ReadAsStringAsync();
                }
            }
                StateHasChanged();
            loader = false;
        }
        catch (Exception ex)
        {
            loader = false;
            toastService.ShowError(ex.Message);
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }
    private async Task GetWholesSalerUsersList(long wholesalerId, string name)
    {
        // tableLabel = "Loading...";
        try
        {

            WholesalerName = name;
            WholesalerID = wholesalerId;

            var apiUrl = $"{_configuration["API_App_URL"]}/api/Wholesaler/GetWholesaleUserListBysalerID?id={wholesalerId}";
            // Make the API call
            var response = await httpClient.GetAsync(apiUrl);

            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<PagerResponse<UserDetail>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                wholesalerUserList = result?.data ?? new List<UserDetail>();
                await JSRuntime.InvokeVoidAsync("showModal", "ViewUerModal");
                StateHasChanged();
            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ API Response: {response.StatusCode}");
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Console.WriteLine("❌ 404 Not Found: The requested resource was not found.");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    Console.WriteLine("❌ 401 Unauthorized: Token is invalid or expired.");
                    await _localStorage.RemoveItemAsync("authToken");
                    ///navigator.NavigateTo("/login");
                }
            }
            loader = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            loader = false;
            Console.WriteLine($"❌ Exception in GetProductData: {ex.Message}");
        }
    }

    public async Task UpdateWholesalerStatus(long userID)
    {

        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Wholesaler/UpdateWholesalerStatus?id={userID}";
            var response = await httpClient.GetAsync(apiUrl);

            if (response.IsSuccessStatusCode)
            { 

                
                toastService.ShowSuccess("Status has been updated successfully.");
                await GetAllWholesalerList();
               
                 

            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
            }
            loader = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            loader = false;
            toastService.ShowError(ex.Message);
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }
}
 


