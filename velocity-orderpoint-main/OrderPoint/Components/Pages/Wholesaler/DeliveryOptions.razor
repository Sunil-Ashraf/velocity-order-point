                                           AmPm="false" TimeChanged="@(time => ValidateDayTime("Wednesday","End",time) )" />
                        </td>

                    </tr>
                    <tr>

                        <td class="px-4 py-2">Thursday</td>
                        <td class="px-4 py-2">
                            <MudTimePicker Label=""
                                           Time="deliveryModel.ThursdayStartTime"
                                           AmPm="false" TimeChanged="@(time => ValidateDayTime("Thursday","Start",time) )" />
                        </td>
                        <td class="px-4 py-2">
                            <MudTimePicker Label=""
                                           Time="deliveryModel.ThursdayEndTime"
                                           AmPm="false" TimeChanged="@(time => ValidateDayTime("Thursday","End",time) )" />
                        </td>

                    </tr>
                    <tr>

                        <td class="px-4 py-2">Friday</td>
                        <td class="px-4 py-2">
                            <MudTimePicker Label=""
                                           Time="deliveryModel.FridayStartTime"
                                           AmPm="false" TimeChanged="@(time => ValidateDayTime("Friday","Start",time) )" />
                        </td>
                        <td class="px-4 py-2">
                            <MudTimePicker Label=""
