                    <tr>

                        <td class="px-4 py-2">Wednesday</td>
                        <td class="px-4 py-2">
                            <MudTimePicker Label=""
                                           Time="deliveryModel.WednesdayStartTime"
                                           AmPm="false" TimeChanged="@(time => ValidateDayTime("Wednesday" ,"Start",time) )" />
                        </td>
                        <td class="px-4 py-2">
                            <MudTimePicker Label=""
