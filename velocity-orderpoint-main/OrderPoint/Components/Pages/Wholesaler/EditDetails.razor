@page "/view-details/edit-details/{WholesalerID:long}"


@using Blazored.Toast.Services
@using OrderPoint.Components.Common

@using OrderPoint.Domain.Common
@using OrderPoint.Domain.ViewModel
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text
@using OrderPoint.Helper
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
@rendermode InteractiveServer
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IConfiguration _configuration
@inject IJSRuntime JSRuntime
 
@inject NotificationService NotificationService
@inject IHttpContextAccessor HttpContextAccessor
@using TinyMCE.Blazor
<AppToast />
<Auth setAuth="@setAuth" />
<div class="min-h-screen mt-3">
        <EditForm Model="wholesalerModel" OnValidSubmit="AddEditWholesaleDetail">
    <div class="">
        <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
            <div class="text-2xl font-semibold text-black">
                Edit Wholesaler
            </div>
            <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                <a href="/view-details" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                    <i class="fa fa-arrow-left pe-2"></i>Back To List
                </a>
                <button type="submit" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                    Save
                </button>
            </div>
           
        </div>
    </div>
    <div>
            <DataAnnotationsValidator />
            <div class="row">
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md font-medium text-black mb-1 ">Name</label>
                        <input type="text" @bind-value="@wholesalerModel.Name" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" />
                        <ValidationMessage For="@(()=>wholesalerModel.Name)" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md font-medium text-black mb-1 ">Address</label>
                        <input type="text" @bind-value="@wholesalerModel.Address" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md font-medium text-black mb-1 ">Telephone</label>
                        <input type="text" @bind-value="@wholesalerModel.Telephone" class="phoneInput w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" />
                        <ValidationMessage For="@(()=>wholesalerModel.Telephone)" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md font-medium text-black mb-1 ">Email</label>
                        <input type="text" @bind-value="@wholesalerModel.Email" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" />
                        <ValidationMessage For="@(()=>wholesalerModel.Email)" />
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md text-[16px] text-black mb-1 ">Landing Page Email</label>
                        <input type="text" @bind-value="@wholesalerModel.LandingPageEmail" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1" />
                        <ValidationMessage For="@(()=>wholesalerModel.LandingPageEmail)" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md text-[16px] text-black mb-1 ">Landing Page Phone</label>
                        <input type="text" @bind-value="@wholesalerModel.LandingPageTelephone" class="phoneInput w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1" />
                        <ValidationMessage For="@(()=>wholesalerModel.LandingPageTelephone)" />
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md text-[16px] text-black mb-1 ">Landing Page Welcome Message</label>
                        <input type="text" @bind-value="@wholesalerModel.WelcomeMessage" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1" />
                        <ValidationMessage For="@(()=>wholesalerModel.WelcomeMessage)" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md font-medium text-black mb-1 ">Upload Logo</label>
                        @* <input type="file" class="w-full px-6 py-2 rounded-full border border-[#4E4D4D] bg-white focus:outline-none  focus:ring-1 focus:ring-[#D2D2D2]" name="name" value="" /> *@

                        <InputFile OnChange="HandleSelected" MaxFileSize="10485760" />

                        <div>
                            <small>
                                The maximum file size for uploads is 999 KB
                                Only image files (JPG, GIF, PNG, BMP) are allowed
                            </small>
                        </div>
                        @if (wholesalerModel.ID.HasValue && wholesalerModel.ID.Value > 0)
                        {
                            <div class="mb-2 mt-2">
                                <img src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{wholesalerModel.ImagePath}")"
                                     onerror="this.onerror=null;this.src='./images/PlaceHolder.png';"
                                     style="width:70px;height:35px" alt="Alternate Text" />
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-4">
                        <label class="block text-md text-[16px] text-black mb-1 ">Upload Landing Page Banner</label>

                        <InputFile OnChange="HandleBannerImage" MaxFileSize="10485760" />

                        <div>
                            <small>

                                Only image files (JPG, GIF, PNG, BMP) are allowed
                            </small>
                        </div>
                        @if (wholesalerModel.ID.HasValue && wholesalerModel.ID.Value > 0)
                        {
                            <div class="mb-2 mt-2">
                                <img src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{wholesalerModel.BannerImagePath}")"
                                     onerror="this.onerror=null;this.src='./images/PlaceHolder.png';"
                                     style="width:70px;height:35px" alt="Alternate Text" />
                            </div>
                        }
                    </div>

                </div>
                   <div class="col-lg-12">
                    <div class="mb-4">
                        <label class="block text-md text-[16px] text-black mb-1 ">Landing Page Description</label>
                        @* <textarea @bind="@wholesalerModel.Description"
                                  class="w-full px-6 py-2 rounded-xl border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1"
                                  rows="4"
                                  placeholder="Enter description..."></textarea> *@
                        <Editor Init="@(new {plugins = "link", toolbar = "undo redo | bold italic underline | link", menubar = false})" @bind-Value=wholesalerModel.Description Field="@(() => wholesalerModel.Description)" />

                        <ValidationMessage For="@(()=>wholesalerModel.Description)" />
                    </div>
                </div>
                
                
            </div>
    </div>
        </EditForm>
</div>


@code {

    [Parameter]
    public long WholesalerID { get; set; }

    AddEditWholesalerModel wholesalerModel = new();
    private IBrowserFile? SelectedFile;
    private bool isAuthenticated;
    private IBrowserFile? SelectedBannerFile;
    private void setAuth(bool val)
    {
        if (val)
        {
            isAuthenticated = val;
            StateHasChanged();
        }
        else
        {
            navigator.NavigateTo("/login", true);
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string token = await _localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                await GetWholesalerByID(WholesalerID,false);
                await JSRuntime.InvokeVoidAsync("applyPhoneMask", "phoneInput");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("applyPhoneMask", "phoneInput");
                navigator.NavigateTo("/login");
            }

        }
    }
    private async Task AddEditWholesaleDetail()
    {
        try
        {

            //var resJson = JsonSerializer.Serialize(wholesalerModel);
            wholesalerModel.ID = WholesalerID;

            var formData = new MultipartFormDataContent();
            formData.Add(new StringContent(wholesalerModel.Name), "Name");
            formData.Add(new StringContent(wholesalerModel.ID.ToString()), "ID");
            formData.Add(new StringContent(wholesalerModel.Address), "Address");
            formData.Add(new StringContent(wholesalerModel.Email), "Email");
            formData.Add(new StringContent(wholesalerModel.Telephone), "Telephone");
            if (!String.IsNullOrEmpty(wholesalerModel.LandingPageEmail))
            {
                formData.Add(new StringContent(wholesalerModel.LandingPageEmail), "LandingPageEmail");
            }
            if (!String.IsNullOrEmpty(wholesalerModel.LandingPageTelephone))
            {
                formData.Add(new StringContent(wholesalerModel.LandingPageTelephone), "LandingPageTelephone");
            }
            if (!String.IsNullOrEmpty(wholesalerModel.Description))
            {
                formData.Add(new StringContent(wholesalerModel.Description), "Description");
            }
            if (!String.IsNullOrEmpty(wholesalerModel.WelcomeMessage))
            {
                formData.Add(new StringContent(wholesalerModel.WelcomeMessage), "WelcomeMessage");
            }

            // formData.Add(new StringContent(userProfile.BusinessName), "BusinessName");
            // formData.Add(new StringContent(Convert.ToString(userProfile.BusinessDescriptionId)), "BusinessDescriptionId");
            // formData.Add(new StringContent(Convert.ToString(userProfile.CompanySizeId)), "CompanySizeId");
            //formData.Add(new StreamContent(ProfilePicture.OpenReadStream()), "ProfilePicture", ProfilePicture.Name);

            if (SelectedFile is not null)
            {
                var fileContent = new StreamContent(SelectedFile.OpenReadStream(long.MaxValue));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(SelectedFile.ContentType);
                formData.Add(fileContent, "ProfilePicture", SelectedFile.Name);
            }

            if (SelectedBannerFile is not null)
            {
                var fileContent = new StreamContent(SelectedBannerFile.OpenReadStream(long.MaxValue));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(SelectedBannerFile.ContentType);
                formData.Add(fileContent, "BannerPicture", SelectedBannerFile.Name);
            }

            var response = await httpClient.PostAsync($"{_configuration["API_App_URL"]}/api/Wholesaler/AddEditWholesaler", formData);
            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                toastService.ShowError("API Response is null. Possible network error or invalid URL. ");
                return;
            }
            if (response.IsSuccessStatusCode)
            {

                await GetWholesalerByID(WholesalerID, true);
                if (WholesalerID > 0)
                {

                    var context = HttpContextAccessor.HttpContext;

                     
                    NotificationService.SuccessMessage = "Detail has been updated successfully.";
                    // toastService.ShowSuccess("Customer has been added successfully.");
                    navigator.NavigateTo("/view-details");
                }
                else
                {

                    NotificationService.SuccessMessage = "Detail has been addedd successfully.";

                    wholesalerModel = new AddEditWholesalerModel();
                }

 


            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error updating profile: {ex.Message}");
        }
    }

     
    private async Task HandleSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Optional: Limit file size manually
        if (file.Size > 1 * 1024 * 1024) // 1 MB = 1,048,576 bytes
        {
            toastService.ShowSuccess("File is too large. Max allowed is 1 mb.");
            //uploadMessage = "File is too large. Max allowed is 10 MB.";
            return;
        }
        SelectedFile = e.File;
        // // Read file into memory
        // var buffer = new byte[file.Size];
        // await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);

        // You can now store, send, or process the buffer
        // uploadMessage = $"Uploaded: {file.Name} ({file.Size} bytes)";
    }
    private async Task HandleBannerImage(InputFileChangeEventArgs e)
    {
        var file = e.File;

        // Optional: Limit file size manually
        // if (file.Size > 1 * 1024 * 1024) // 1 MB = 1,048,576 bytes
        // {
        //     toastService.ShowError("File is too large. Max allowed is 1 mb.");
        //     //uploadMessage = "File is too large. Max allowed is 10 MB.";
        //     return;
        // }
        SelectedBannerFile = e.File;
        // // Read file into memory
        // var buffer = new byte[file.Size];
        // await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);

        // You can now store, send, or process the buffer
        // uploadMessage = $"Uploaded: {file.Name} ({file.Size} bytes)";
    }
    public async Task GetWholesalerByID(long id , bool isavedWholesalerinSession)
    {

        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Wholesaler/GetWholesalerByID?Id={id}";
            var response = await httpClient.GetAsync(apiUrl);

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<Response<AddEditWholesalerModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                wholesalerModel = result?.Data ?? new AddEditWholesalerModel();
                // adminmodel.IsEdit = true;
                //await JSRuntime.InvokeVoidAsync("showModal", "EditUser_modal");
                //await JSRuntime.InvokeVoidAsync("hideModal", "ViewUerModal");
                //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();
                if (isavedWholesalerinSession)
                {
                    var context = HttpContextAccessor.HttpContext;
                    context.Session.SetObject("Wholesaler", wholesalerModel);
                }
                StateHasChanged();

            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                toastService.ShowError(errorDetails);
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.Message);
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }
}
 


