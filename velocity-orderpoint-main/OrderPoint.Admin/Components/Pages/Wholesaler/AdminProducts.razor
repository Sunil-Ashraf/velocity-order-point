@page "/view-wholesaler/products-wh-grid-view/{WholesalerID:long}"
 @using Blazored.Toast.Services
@using OrderPoint.Admin.Components.Common

@using OrderPoint.Domain.Common
@using OrderPoint.Domain.ViewModel
@using Blazored.LocalStorage
@using System.Net.Http.Headers
@using System.Text.Json
@using System.Text
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
 @rendermode InteractiveServer
@inject Blazored.LocalStorage.ILocalStorageService _localStorage
@inject IConfiguration _configuration
@inject IJSRuntime JSRuntime

<div class="min-h-screen mt-3">
    <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
        <div class="text-2xl font-semibold text-black">
            Products Grid View
        </div>
        <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
            <a href="/view-wholesaler" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                <i class="fa fa-arrow-left pe-2"></i>Back To List
            </a>
        </div>
    </div>
    <div class="flex justify-content-between align-items-center mb-3 bg-[#F2F2F2] rounded-lg px-3 py-1">
        <div>
            @*   <img src="/images/medafoot.png" class="img-fluid w-[100px]" alt="medafoot" /> *@

            <img src="@($"{_configuration["API_App_URL"]}/WholesalePictures/{Image}")"
            onerror="this.onerror=null;this.src='./images/PlaceHolder.png';"
            class=" img-fluid w-[100px]"  alt="Alternate Text" />
        </div>
        <div class="text-2xl font-semibold text-black">
            @Wholesaler
        </div>
    </div>
    <div class="row">

        <div class="col-lg-6">
            <div class="">

                <select @onchange="OnUserChanged" type="text" class="w-full px-6 pr-10 py-2 rounded-full border border-[#C4C4C4] focus:outline-none focus:ring-[#D2D2D2]  focus:ring-1">

                    <option value="">All Products</option>
                    @foreach (var item in lstCategoryList)
                    {
                        <option value="@item.Id">@item.CategoryName</option>
                    }
                </select>

            </div>
        </div>
        <div class="col-lg-6"> </div>





    </div>
    @if (lstProducts.Count() > 0)
    {
        <div class="row mt-3">


            @foreach (var item in lstProducts)
            {
                bool isChecked = false;
                if (cartList != null)
                {
                    var cartitem = cartList.FirstOrDefault(i => i.Id == item.Id);

                    if (cartitem != null)
                    {
                        if (cartitem.IsItemInCart.HasValue == cartitem.IsItemInCart.Value == true)
                        {
                            isChecked = true;
                        }
                        if (cartitem.Quantity > 1)
                        {
                            item.Quantity = cartitem.Quantity;
                        }
                    }
                }
                <div class="col-lg-3 mb-3">

                    <div class="bg-[#F2F2F2] rounded-[16px] p-6">
                        @*   <div class="mb-2">
                            <img src="/images/Frame.png" />
                        </div> *@
                        <div class="mb-1 d-flex justify-content-between align-items-center">
                            <span class="text-[#1A1A1A] font-normal text-[16px] leading-[150%] tracking-[0%]">
                                @item.ProductName
                            </span>
                            @if (isChecked == true)
                            {
                                <span>
                                    <i class="fa fa-check fs-3 text-success"> </i>
                                </span>
                            }
                        </div>
                        <div class="d-flex justify-content-between my-2">
                            <!--<div>-->
                            @*<span class="text-[#1A1A1A] font-semibold text-[18px] leading-[150%] tracking-[0%]">
                                From £7.68
                            </span>*@
                            <!--</div>-->

                            <div class="flex items-center gap-2 ">
                                @{
                                    string increase = "Increase";
                                    string decrease = "decrease";
                                }
                                <button type="button" @onclick="()=>SetQuantity(item,decrease)"  class="" data-type="minus"><span class=""><i class="fa fa-minus text-sm"></i></span></button>


                                <input type="text"     @bind="item.Quantity" min="0.001" max="50000" class="border-b border-gray-300 border-t focus:outline-none focus:ring-[#D2D2D2]  focus:ring-1 py-0 text-center text-sm" style="width: 75px;">


                                <button type="button" @onclick="()=>SetQuantity(item,increase)"  class="" data-type="plus"><span class=""><i class="fa fa-plus text-sm"></i></span></button>
                            </div>
                        </div>
                        @if (isChecked == true)
                        {
                            <button @onclick="()=>AddtoCart(item ,true)" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center w-full mt-2">
                                Update Cart
                            </button>
                        }
                        else
                        {
                            <button @onclick="()=>AddtoCart(item,false)" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center w-full mt-2">
                                Add To Cart
                            </button>
                        }
                        @*  <button class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center w-full mt-2">
                            Add To Cart
                        </button> *@
                    </div>
                </div>
            }

        </div>
        <div class="row">
            <div class="flex justify-center items-center  mt-4">
                <!-- Previous Button -->
                <button @onclick="PreviousPage" disabled="@(productsPageNumber == 1)"
                class="px-2 py-[0.7rem] border rounded-md bg-white text-myblueGray hover:bg-gray-200 disabled:opacity-50">
                    <img src="./images/back.png" alt="Previous" />
                </button>

                <!-- Page Numbers -->
                @for (int i = 1; i <= productsTotalPages; i++)
                {
                    int currentPage = i; // Create a local copy of i

                    if (currentPage == 1 || currentPage == 2 || currentPage == productsTotalPages - 1 || currentPage == productsTotalPages)
                    {
                        <!-- Always show first two and last two pages -->
                        <button @onclick="() => ChangePage(currentPage)"
                        class="px-3 py-1 border rounded-md bg-white hover:bg-gray-200 @(productsPageNumber == currentPage ? "bg-gray-100 font-bold" : "")">
                            @currentPage
                        </button>
                    }
                    else if (currentPage >= productsPageNumber - 1 && currentPage <= productsPageNumber + 1)
                    {
                        <button @onclick="() => ChangePage(currentPage)"
                        class="px-3 py-1 border rounded-md bg-white hover:bg-gray-200 @(productsPageNumber == currentPage ? "bg-gray-100 font-bold" : "")">
                            @currentPage
                        </button>
                    }
                    else if ((currentPage == 3 && productsPageNumber > 4) || (currentPage == productsTotalPages - 2 && productsPageNumber < productsTotalPages - 3))
                    {
                        <span class="px-3 py-1 bg-white">...</span>
                    }
                }

                <!-- Next Button -->
                <button @onclick="NextPage" disabled="@(productsPageNumber == productsTotalPages)"
                class="px-2 py-[0.7rem] border rounded-md bg-white hover:bg-gray-200 disabled:opacity-50">
                    <img src="./images/next.png" alt="Next" />
                </button>
            </div>
        </div>
    }
    <div class="modal fade" id="editNotesModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="viewCargoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-2xl font-semibold text-black" id="viewCargoModalLabel">
                        Add notes for this item
                    </h5>
                    <button @onclick="()=>AddtoCartNotes(CommentText)" class="text-gray-500 hover:text-gray-700" data-bs-dismiss="modal"><img src="./images/close.png"></button>
                </div>
                <div class="modal-body">
                    <div class="">
                        <textarea @bind="CommentText"
                        class="w-full px-6 py-2 rounded-md mb-0 border border-[#C4C4C4] focus:outline-none focus:ring-[#D2D2D2]  focus:ring-1"
                        rows="4">
                        </textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button @onclick="()=>AddtoCartNotes(CommentText)" data-bs-dismiss="modal" class="rounded-full border border-[#4E4D4D] text-dark px-4 py-2 flex-grow md:flex-none text-[16px] text-center">Cancel</button>
                    <button @onclick="()=>AddtoCartNotes(CommentText)" class="bg-[#4E4D4D] rounded-full border-black text-white border px-4 py-2 hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public long WholesalerID { get; set; }

    public string Wholesaler { get; set; }  
    [Parameter]
    public string Image { get; set; }
    private Int64? CategoryID { get; set; }
    private System.Timers.Timer _debounceTimer;
    private string loading { get; set; } = "Loading...";
    private List<ProductsViewModel> lstCategoryList = new();

    [Parameter]
    public bool loader { get; set; } = false;

    private bool isAuthenticated;
    private ProductsViewModel selectedItem { get; set; }

    private List<ProductsViewModel> cartList = new List<ProductsViewModel>();
    private string CommentText { get; set; } = "";
    private Int32 SelectedQty { get; set; }
    private Int64 SelectedProduct { get; set; }
    private bool IsCustomerRole { get; set; }
    private bool SelectedIsUpdate { get; set; }
    private String SelectedProductName { get; set; }
    private String UserRole { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string token = await _localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

                await GetAllCategory();
                await GetAllProduct();

            }
            else
            {
                navigator.NavigateTo("/");
            }

        }
    }
    private async Task GetAllCategory()
    {
        // tableLabel = "Loading...";
        try
        {
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Product/GetAllCategoryBywholesaler?wholesalerID={WholesalerID}&isGetAllCategory=true";
            // Make the API call
            var response = await httpClient.GetAsync(apiUrl);

            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<PagerResponse<ProductsViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                lstCategoryList = result?.data ?? new List<ProductsViewModel>();

                Wholesaler = result.wholesalerDetail.Name;
                Image = result.wholesalerDetail.ImagePath;

            }
            else
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ API Response: {response.StatusCode}");
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Console.WriteLine("❌ 404 Not Found: The requested resource was not found.");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    Console.WriteLine("❌ 401 Unauthorized: Token is invalid or expired.");
                    await _localStorage.RemoveItemAsync("authToken");
                    navigator.NavigateTo("/");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in GetProductData: {ex.Message}");
        }
    }
    private async Task OnUserChanged(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value?.ToString()))
        {
            var selectedId = Convert.ToInt64(e.Value);// e.Value?.ToString();
            CategoryID = selectedId;
        }
        else{
            CategoryID = null;
        }
        await GetAllProduct();
        // You can fetch user details here if needed.
    }



    private List<ProductsViewModel> lstProducts = new();
    // Product Pagination
    private int pageSize = 10;
    private int productsPageNumber = 1;
    private int productsTotalPages = 1;
    private string productsSortColumn = "ProductName";
    private string sortOrder = "asc";

    private string search = string.Empty;

    private async Task GetAllProduct()
    {
        // tableLabel = "Loading...";
        try
        {
            cartList = await _localStorage.GetItemAsync<List<ProductsViewModel>>("AdminCartItemList");
            if (cartList == null)
            {
                cartList = new List<ProductsViewModel>();
            }
            var apiUrl = $"{_configuration["API_App_URL"]}/api/Product/GetAllProductsBywholesaler?pageNumber={productsPageNumber}&pageSize={pageSize}&sortColumn={productsSortColumn}&sortOrder={sortOrder}&search={search}&wholesalerID={WholesalerID}&categoryID={CategoryID}";
            // Make the API call
            var response = await httpClient.GetAsync(apiUrl);

            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<PagerResponse<ProductsViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                lstProducts = result?.data ?? new List<ProductsViewModel>();
                productsTotalPages = result?.totalRecords > 0 ? (int)Math.Ceiling((double)result.totalRecords / pageSize) : 0;
                if (lstProducts.Count == 0)
                {
                    loading = "No record found.";
                }
            }
            else
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ API Response: {response.StatusCode}");
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Console.WriteLine("❌ 404 Not Found: The requested resource was not found.");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    Console.WriteLine("❌ 401 Unauthorized: Token is invalid or expired.");
                    await _localStorage.RemoveItemAsync("authToken");
                    navigator.NavigateTo("/");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in GetProductData: {ex.Message}");
        }
    }
    private async Task NextPage()
    {
        if (productsPageNumber < productsTotalPages)
        {
            productsPageNumber++;
            await GetAllProduct();
        }
    }
    private async Task PreviousPage()
    {
        if (productsPageNumber > 1)
        {
            productsPageNumber--;
            await GetAllProduct();
        }
    }
    private async Task ChangePage(int page)
    {
        productsPageNumber = page;
        await GetAllProduct();
    }

    private bool isAscending = true;

    private async Task SortTable(string columnName)
    {
        if (productsSortColumn == columnName)
        {
            isAscending = !isAscending;
        }
        else
        {
            productsSortColumn = columnName;
            isAscending = true;
        }

        if (isAscending)
        {
            sortOrder = "asc";
        }
        else
        {
            sortOrder = "desc";
        }
        await GetAllProduct();
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        string currentSearch = e.Value?.ToString();

        _debounceTimer?.Stop();
        _debounceTimer = new System.Timers.Timer(800);
        _debounceTimer.Elapsed += async (sender, args) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                search = currentSearch;
                await GetAllProduct();
                StateHasChanged();
            });
        };
        _debounceTimer.Start();
    }

    private async Task SetQuantity(ProductsViewModel item , string type){
        if(type=="Increase")
        {
            item.Quantity += 1;
        }
        else{
            if (item.Quantity ==0) {
                item.Quantity = 0;
            }
            else {
                item.Quantity -= 1; 
            }
        }

    }
    private async Task AddtoCartNotes(string comments)
    {

        try
        {
            if (SelectedIsUpdate == true)
            {
                var cartitem = cartList.FirstOrDefault(k => k.Id == SelectedProduct);
                if (cartitem != null)
                {
                    cartitem.IsItemInCart = true;
                    cartitem.Id = selectedItem.Id;
                    cartitem.Description = String.IsNullOrEmpty(comments) ? String.Empty : comments;
                    cartitem.Quantity = selectedItem.Quantity;
                    cartitem.ProductName = selectedItem.ProductName;
                    cartitem.QuantityTypeId = selectedItem.QuantityTypeId;
                }

            }
            else
            {
                ProductsViewModel model = new ProductsViewModel();
                model.IsItemInCart = true;
                model.Id = selectedItem.Id;
                model.Description = comments;
                model.Quantity = selectedItem.Quantity;
                model.ProductName = selectedItem.ProductName;
                model.QuantityTypeId = selectedItem.QuantityTypeId;
                cartList.Add(model);
            }


            await _localStorage.SetItemAsync("AdminCartItemList", cartList);
            await JSRuntime.InvokeVoidAsync("hideModal", "editNotesModal");
            // CookieService.SetList("CartItemList", cartList);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        // StateHasChanged();
    }
    private async Task AddtoCart(ProductsViewModel item, bool isUpdate)
    {
        // SelectedQty = qty;
        // SelectedProduct = productId;
        // SelectedProductName = name;
        SelectedIsUpdate = isUpdate;
        selectedItem = item;
        var cartitem = cartList.FirstOrDefault(i => i.Id == item.Id);
        if (cartitem != null)
        {
            CommentText = cartitem.Description;
        }
        else
        {
            CommentText = String.Empty;
        }
        await JSRuntime.InvokeVoidAsync("showModal", "editNotesModal");
    }
}
