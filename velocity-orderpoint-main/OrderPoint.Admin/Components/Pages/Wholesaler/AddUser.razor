@page "/add-wh-user"
    <div class="min-h-screen mt-3">
        <div class="">
            <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
                <div class="text-2xl font-semibold text-black">
                    Add/Edit User
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                    <a href="/view-wholesaler" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                        <i class="fa fa-arrow-left pe-2"></i>Back To List
                    </a>
                </div>
            </div>
        </div>
        <div>
            <div class="row">
                <div class="col-lg-4">
                    <div class="mb-2">
                        <label class="block text-md text-[16px] text-black mb-1 ">User Type</label>
                        <input type="text" disabled class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" value="New user for Meadfoot Meats" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-2">
                        <label class="block text-md text-[16px] text-black mb-1 ">First Name</label>
                        <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" value="" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-2">
                        <label class="block text-md text-[16px] text-black mb-1 ">Last Name</label>
                        <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" value="" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-2">
                        <label class="block text-md text-[16px] text-black mb-1 ">Email</label>
                        <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" value="" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-2">
                        <label class="block text-md text-[16px] text-black mb-1 ">Confirm Email</label>
                        <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" value="" />
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="mb-2">
                        <label class="block text-md text-[16px] text-black mb-1 ">New User Password</label>
                        <input type="text" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid" name="name" value="" />
                        <a href="javascript:;" class="fs-7 ps-2 text-[#4c8be8]"><small>Generate Password</small></a>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="mb-2 d-inline-block">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" class="transform scale-125 text-blue-500 accent-blue-500">
                            BCC this wholesaler user when new orders are placed
                        </label>
                    </div>
                    <br />
                    <div class="mb-2 d-inline-block">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" class="transform scale-125 text-blue-500 accent-blue-500">
                            Notify new user?
                        </label>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="text-end">
                        <button class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                            Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @code {

    }
