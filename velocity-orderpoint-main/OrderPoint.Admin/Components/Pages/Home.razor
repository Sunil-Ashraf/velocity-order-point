@page "/admin"

<div class="min-h-screen mt-3">
    <div class="">




        <div class="">
            <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
                <div class="text-2xl font-semibold text-black">
                    Admin users
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                    <button data-bs-target="#addUser_modal" data-bs-toggle="modal" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                        <i class="fa fa-plus pe-2"></i>Add User
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto rounded-[0.9rem] border ">
                <table class="table-auto  w-full    text-left text-sm ">
                    <thead class="text-sm font-medium    text-black bg-[#F7F7F7] ">
                        <tr>
                            <th class="px-4 py-2">
                                <button class="flex items-center space-x-1">
                                    <span class="text-nowrap flex items-center ">
                                        ID
                                    </span>
                                    <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2  ">
                                <button class="flex items-center space-x-1">
                                    <span> Last Name </span>
                                    <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2">
                                <button class="flex items-center space-x-1">
                                    <span> First Name </span>
                                    <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2">
                                <button class="flex items-center space-x-1">
                                    <span> Email Address </span>
                                    <i class="bi bi-arrow-up text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2">
                                <button class="flex items-center space-x-1">
                                    <span class="flex items-center text-nowrap"> Last Login </span>
                                    <i class="bi bi-arrow-up text-black font-bold" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>
                            <th class="px-4 py-2">
                                <button class="flex items-center space-x-1">
                                    <span class="flex items-center text-nowrap"> Date Created </span>
                                    <i class="bi bi-arrow-up text-black font-bold" style=" font-size: 11px !important; width: 3px !important;"></i>
                                    <i class="bi bi-arrow-down text-gray-400" style=" font-size: 11px !important; width: 3px !important;"></i>
                                </button>
                            </th>

                            <th class="px-4 py-2">
                                <div class="flex items-center  ">
                                    Actions
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white  p-4 mb-6 text-sm font-normal text-black">
                        <tr>
                            <td class="px-4 py-2">2</td>
                            <td class="px-4 py-2">David</td>
                            <td class="px-4 py-2">Hill</td>
                            <td class="px-4 py-2">david.hill@conexiosoftware.com</td>
                            <td class="px-4 py-2">11/07/2025</td>
                            <td class="px-4 py-2">21/12/2016</td>
                            <td class="px-4 py-2">
                                <div class="flex align-items-center">
                                    <a href="javascript:;" class="text-gray-600 hover:text-black me-2">
                                        <img class="w-[16px h-[18px]" src="./images/edit.png">
                                    </a>
                                    <a href="javascript:;" title="Delete" class="text-gray-600 hover:text-black">
                                        <span>
                                            <i class="fa fa-trash-alt"></i>
                                        </span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="flex justify-center items-center  mt-4"><button disabled="" class="px-2 py-[0.7rem] border rounded-md bg-white text-myblueGray hover:bg-gray-200"><img src="./images/back.png" alt="Previous"></button><button disabled="" class="px-2 py-[0.7rem] border rounded-md bg-white hover:bg-gray-200"><img src="./images/next.png" alt="Next"></button></div>
        </div>
    </div>
    <div class="modal fade" id="addUser_modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="viewCargoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-2xl font-semibold text-black" id="viewCargoModalLabel">Add User</h5>
                    <button class="text-gray-500 hover:text-gray-700" data-bs-dismiss="modal"><img src="./images/close.png"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="block text-md text-[16px] text-black mb-1 ">User Type</label>
                                <input class="w-full border border-[#d6d6d6] rounded-full p-2 bg-grey px-3" disabled />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="block text-md text-[16px] text-black mb-1 ">
                                    Email Address
                                </label>
                                <input class="w-full border border-[#d6d6d6] rounded-full p-2 bg-grey px-3" value="" disabled />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="block text-md text-[16px] text-black mb-1 ">First Name</label>
                                <input class="w-full border border-[#d6d6d6] rounded-full p-2 bg-white px-3" />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="block text-md text-[16px] text-black mb-1 ">Last Name</label>
                                <input class="w-full border border-[#d6d6d6] rounded-full p-2 bg-white px-3" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button data-bs-dismiss="modal" class="rounded-full border border-[#4E4D4D] text-dark px-4 py-2 flex-grow md:flex-none text-[16px] text-center">Cancel</button>
                    <button class="bg-[#4E4D4D] rounded-full border-black text-white border px-4 py-2  hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
