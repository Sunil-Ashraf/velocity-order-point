        }
    }
    private async Task PreviousPage()
    {
        if (customerPageNumber > 1)
        {
            customerPageNumber--;
            await GetAdminList();
        }
    }
    private async Task ChangePage(int page)
    {
        customerPageNumber = page;
        await GetAdminList();
    }

    private bool isAscending = true;

    private async Task SortTable(string columnName)
    {
        if (customerSortColumn == columnName)
        {
            isAscending = !isAscending;
        }
        else
        {
            customerSortColumn = columnName;
            isAscending = true;
        }

        if (isAscending)
        {
            sortOrder = "asc";
        }
        else
        {
            sortOrder = "desc";
        }
        await GetAdminList();
    }
    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        string currentSearch = e.Value?.ToString();
        StateHasChanged();
        _debounceTimer?.Stop();
        _debounceTimer = new System.Timers.Timer(800);
        _debounceTimer.Elapsed += async (sender, args) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                search = currentSearch;
                await GetAdminList();
                StateHasChanged();
            });
        };
        _debounceTimer.Start();
        // search = e.Value?.ToString() ?? "";
        // await Task.Delay(2000); // 2-second delay
        // await GetAdminList();
    }

    public  void GenerateRandomString(int length)
    {

        if (length < 4)
            throw new ArgumentException("Length must be at least 4 to include all required character types.");

        const string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const string lower = "abcdefghijklmnopqrstuvwxyz";
        const string digits = "0123456789";
        const string special = "!@#$%^&*()-_=+[]{};:,.<>?";

        // Required characters
        char[] result = new char[length];
        result[0] = upper[random.Next(upper.Length)];
        result[1] = lower[random.Next(lower.Length)];
        result[2] = digits[random.Next(digits.Length)];
        result[3] = special[random.Next(special.Length)];

        // Pool for remaining characters
        string allChars = upper + lower + digits + special;

        for (int i = 4; i < length; i++)
        {
            result[i] = allChars[random.Next(allChars.Length)];
        }

        // Shuffle the array to randomize order
        adminmodel.Password = new string(result.OrderBy(_ => random.Next()).ToArray());

        // adminmodel.Password = result.ToString();
    }
