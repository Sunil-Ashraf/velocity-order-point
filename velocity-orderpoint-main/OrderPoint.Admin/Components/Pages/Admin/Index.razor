                await JSRuntime.InvokeVoidAsync("showModal", "EditUser_modal");
                //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();
                StateHasChanged();
            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                toastService.ShowError(errorDetails);
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.Message);
            Console.WriteLine($"Error fetching supplier data: {ex.Message}");
        }
    }
    public async Task DeleteUser(long userID)
