@page "/"
@layout OrderPoint.Admin.Components.Layout.AccountLayout
@using Blazored.LocalStorage
@using System.Text.Json
@using System.Text
@using Blazored.Toast.Services
@using OrderPoint.Admin.Components.Common
@using OrderPoint.Admin.Services
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
<AppToast />
@rendermode InteractiveServer
@inject IConfiguration _configuration
@inject ILocalStorageService _localStorage
@inject JwtAuthenticationStateProvider AuthProvider
<PageTitle>Order Point | Login</PageTitle>
<Loader visible=loader />
<div class="min-h-screen flex flex-col items-center justify-content-between bg-white py-4">

    <img src="/images/Order1.png" alt="Logo" class="w-[200px] h-[75px] filter brightness-[0.5]" />

    <div class="w-[480px] flex flex-col items-center">

        <h1 class="font-semibold text-[42px] mb-8 text-[#1A1A1A]">Log in</h1>

        <EditForm Model="Model" OnValidSubmit="Submit" FormName="LoginForm" class="w-full flex flex-col items-center gap-2">
            <DataAnnotationsValidator />
            <div class="mb-4 w-full">
                <InputText @bind-Value="Model.Email" placeholder="Email or phone"
                           class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1" />
                <ValidationMessage For=@(()=>Model.Email) class="text-danger mt-2" />
            </div>
            <div class="w-full relative">
                <InputText @bind-Value="Model.Password"
                           type="@passwordInputType"
                           placeholder="Password"
                           class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1" />

                <button type="button"
                        @onclick="TogglePasswordVisibility"
                        class="absolute right-4 top-1/2 transform -translate-y-1/2 text-gray-500 focus:outline-none">
                    <i class="fas @(isPasswordVisible ? "fa-eye-slash" : "fa-eye")"></i>
                </button>

            </div>
            <ValidationMessage For="@(() => Model.Password)" class="text-danger text-start w-100" />

            <div class="w-full flex justify-between items-center text-sm text-gray-600 px-2 mb-4">
                <label class="flex items-center gap-2 text[#4E4D4D]">
                    <input type="checkbox" @bind="Model.RememberMe"
                           class="transform scale-125 text-[#1A1A1A] accent-[#1A1A1A]" />
                    Remember Me
                </label>

                <a href="/forgot-password" class="text-[#1A1A1A] hover:text-[#1A1A1A] hover:underline">Forgot Password?</a>
            </div>

            <button type="submit"
                    class="bg-[#4E4D4D] text-white font-semibold w-full h-[45px] rounded-full px-6 py-2 hover:bg-[#4E4D4D] mb-4">
                LOG IN
            </button>
        </EditForm>
    </div>
    <div class="">
        <p class="font-[Inter] text-dark font-normal text-base leading-6 tracking-normal">
            Copyright © Order Point @DateTime.Now.Year
        </p>
    </div>
</div>

@code {
    private bool isPasswordVisible = false;
    private string passwordInputType => isPasswordVisible ? "text" : "password";
    private void TogglePasswordVisibility()
    {
        isPasswordVisible = !isPasswordVisible;
    }
    [Parameter]
    public string ReturnUrl { get; set; }
    [Parameter]
    public bool loader { get; set; } = false;
    private bool _hasRendered = false;
    public OrderPoint.Domain.ViewModel.LoginViewModel Model { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRendered)
        {
            loader = true;
            _hasRendered = true;
            await AuthProvider.InitializeAsync();
            // var authState = await AuthProvider.GetAuthenticationStateAsync();
            var isTokenValid = await AuthProvider.IsTokenValidAsync();


            //var user = authState.User;
            // if (user.Identity.IsAuthenticated)
            if (isTokenValid)
            {
                navigator.NavigateTo("/view-admin");
            }

            // Safe to call JS interop/localStorage here
            // await AuthProvider.InitializeAsync();
            //  Userrole = await AuthProvider.GetClaimValue(ClaimTypesEx.Role);
            loader = false;

            StateHasChanged();
        }
    }


    protected override void OnInitialized() => Model ??= new();
    private async void Submit()
    {
        loader = true;
        Model.IsAdminPortal = true;
        var jsonContent = new StringContent(JsonSerializer.Serialize(Model), Encoding.UTF8, "application/json");
        var res = await httpClient.PostAsync(_configuration["API_App_URL"] + "/api/Account/Login", jsonContent);
        if (res.IsSuccessStatusCode)
        {
            var jsonString = await res.Content.ReadAsStringAsync();
            var result = JsonSerializer.Deserialize<OrderPoint.Domain.Common.APIResponse>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            loader = false;
            if (result.Success)
            {
                await _localStorage.SetItemAsync("authToken", result.Message);
                navigator.NavigateTo("/view-admin");
            }
            else
            {
                toastService.ShowError(result.Message);
            }
        }
        else
        {
            loader = false;
        }
        StateHasChanged();
    }
}