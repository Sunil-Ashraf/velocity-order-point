@page "/forgot-password"
@layout OrderPoint.Admin.Components.Layout.AccountLayout

@using Blazored.LocalStorage
@using System.Text.Json
@using System.Text
@using Blazored.Toast.Services
@using OrderPoint.Admin.Components.Common
@using System.ComponentModel.DataAnnotations
@inject HttpClient httpClient
@inject NavigationManager navigator
@inject IToastService toastService
<AppToast />
@rendermode InteractiveServer
@inject IConfiguration _configuration
@inject ILocalStorageService _localStorag
<PageTitle>Order Point | Login</PageTitle>
<Loader visible=loader />
<div class="min-h-screen flex flex-col items-center justify-between bg-white py-4">

    <img src="/images/Order1.png" alt="Logo" class="w-[200px] h-[75px] filter brightness-[0.5]" />

    <div class="w-[480px] flex flex-col items-center mt-6">

        <h1 class="font-semibold text-[42px] text-[#1A1A1A] mb-8 text-center">Forgot Password?</h1>

        <p class="text-sm text-gray-700 mb-6 text-center">
            Enter your email address. We will send you details of how to reset your password.
        </p>

        <EditForm Model="forgotModel" OnValidSubmit="HandleSubmit" class="w-full flex flex-col items-center gap-4">
            <DataAnnotationsValidator />
            <InputText @bind-Value="forgotModel.Email"
            class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1"
            placeholder="Email" />


            <button type="submit"
            class="bg-[#4E4D4D] text-white font-semibold w-full h-[45px] rounded-full px-6 py-2 hover:bg-[#4E4D4D]">
                Submit
            </button>
            <div>
                <a href="/" class="text-[#1A1A1A] hover:text-[#1A1A1A] font-semibold text-decoration-none"> <i class="fa fa-arrow-left pe-1"></i> Back To Login</a>
            </div>
        </EditForm>
    </div>

    <div class="mt-10">
        <p class="font-[Inter] font-normal text-dark text-base leading-6 tracking-normal text-center">
            Copyright © Order Point @DateTime.Now.Year  
        </p>
    </div>
</div>

@code {

    [Parameter]
    public string ReturnUrl { get; set; }
    [Parameter]
    public bool loader { get; set; } = false;
    private ForgotPasswordModel forgotModel = new();
    protected override void OnInitialized() => forgotModel ??= new();
    private async void HandleSubmit()
    {
        loader = true;
        StateHasChanged();

        try
        {
            forgotModel.IsResetByAdmin = true;
            var jsonContent = new StringContent(JsonSerializer.Serialize(forgotModel), Encoding.UTF8, "application/json");
            var res = await httpClient.PostAsync(_configuration["API_App_URL"] + "/api/Account/forgot-password", jsonContent);
            if (res.IsSuccessStatusCode)
            {
                var jsonString = await res.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<OrderPoint.Domain.Common.APIResponse>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (result.Success)
                {
                    forgotModel = new();
                    toastService.ShowSuccess(result.Message);
                }
                else
                {
                    toastService.ShowError(result.Message);
                }
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error : {ex.Message}");
        }
        finally
        {
            loader = false;
            StateHasChanged();
        }
    }
 
    public class ForgotPasswordModel
    {
        public string Email { get; set; }
        public bool? IsResetByAdmin { get; set; }
    }
}
