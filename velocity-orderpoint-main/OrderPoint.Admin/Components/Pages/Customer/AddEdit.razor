@page "/view-customer/add-customer/{CustomeID:long}"
    <PageTitle>Add/Edit Customer</PageTitle>

    @using Blazored.Toast.Services
    @using OrderPoint.Admin.Components.Common

    @using OrderPoint.Admin.Helper
    @using OrderPoint.Domain.Common
    @using OrderPoint.Domain.ViewModel
    @using Blazored.LocalStorage
    @using System.Net.Http.Headers
    @using System.Text.Json
    @using System.Text
    @inject HttpClient httpClient
    @inject NavigationManager navigator
    @inject IToastService toastService
    @rendermode InteractiveServer
    @inject Blazored.LocalStorage.ILocalStorageService _localStorage
    @inject IConfiguration _configuration
    @inject IJSRuntime JSRuntime
    @inject NotificationService NotificationService
    <AppToast />
    <Auth setAuth="@setAuth" />
    <div class="min-h-screen mt-3">
        <div class="">
            <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
                <div class="text-2xl font-semibold text-black">
                    Add/Edit Customer
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                    <a href="/view-customer" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                        <i class="fa fa-arrow-left pe-2"></i>Back To List
                    </a>
                </div>
            </div>
        </div>
        <div>
            <EditForm Model="customerModel" OnValidSubmit="AddEditCustomer">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="block text-md text-[16px] text-black mb-1 ">Name</label>
                            <input type="text" @bind-value="@customerModel.CustomerName" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1  valid">
                            <ValidationMessage For="@(()=>customerModel.CustomerName)" />
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="block text-md text-[16px] text-black mb-1 ">Wholesaler Reference</label>
                            <input type="text" @bind-value="@customerModel.WholesalerReference" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1  valid">
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="mb-4">
                            <label class="block text-md text-[16px] text-black mb-1 ">Select Wholesaler</label>
                            <select @bind="@customerModel.WholesalerID" class="w-full px-6 py-2 rounded-full border border-[#D2D2D2] focus:ring-[#D2D2D2] focus:outline-none focus:ring-1 valid">
                                <option value="">Please Select</option>
                                @foreach (var item in WholesalerList)
                                {
                                    <option value="@item.ID">@item.Name</option>
                                }
                            </select>
                            <ValidationMessage For="@(()=>customerModel.WholesalerID)" />
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="text-end">
                            @if (CustomeID > 0)
                            {
                                <button class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                                    Update
                                </button>
                            }
                            else
                            {
                                <button class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                                    Save
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @code {
        [Parameter]
        public long CustomeID { get; set; }
        private bool isAuthenticated;

        private List<WholesalerViewModel> WholesalerList = new();
        AddEditCustomerModel customerModel = new();
        private void setAuth(bool val)
        {
            if (val)
            {
                isAuthenticated = val;
                StateHasChanged();
            }
            else
            {
                navigator.NavigateTo("/", true);


            }
        }
        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                string token = await _localStorage.GetItemAsync<string>("authToken");
                if (!string.IsNullOrEmpty(token))
                {
                    httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                    await GetAllWholeslerList();
                    if (CustomeID > 0)
                    {
                        await GetCustomerByID();
                    }
                }
                else
                {
                    navigator.NavigateTo("/");
                }

            }
        }
        private async Task GetAllWholeslerList()
        {
            // tableLabel = "Loading...";
            try
            {
                var apiUrl = $"{_configuration["API_App_URL"]}/api/Customer/GetAllWholesalerList";
                // Make the API call
                var response = await httpClient.GetAsync(apiUrl);

                if (response == null)
                {
                    Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                    return;
                }

                if (response.IsSuccessStatusCode)
                {
                    var jsonString = await response.Content.ReadAsStringAsync();
                    var result = JsonSerializer.Deserialize<PagerResponse<WholesalerViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                    WholesalerList = result?.data ?? new List<WholesalerViewModel>();


                }
                else
                {
                    string errorDetails = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"❌ API Response: {response.StatusCode}");
                    if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                    {
                        Console.WriteLine("❌ 404 Not Found: The requested resource was not found.");
                    }
                    else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                    {
                        Console.WriteLine("❌ 401 Unauthorized: Token is invalid or expired.");
                        await _localStorage.RemoveItemAsync("authToken");
                        navigator.NavigateTo("/");
                    }
                }
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Exception in GetProductData: {ex.Message}");
            }
        }
        public async Task GetCustomerByID()
        {

            try
            {
                var apiUrl = $"{_configuration["API_App_URL"]}/api/Customer/GetCustomerByID?Id={CustomeID}";
                var response = await httpClient.GetAsync(apiUrl);

                if (response.IsSuccessStatusCode)
                {
                    var jsonString = await response.Content.ReadAsStringAsync();
                    var result = JsonSerializer.Deserialize<Response<AddEditCustomerModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    customerModel = result?.Data ?? new AddEditCustomerModel();
                    // adminmodel.IsEdit = true;

                    //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();
                    StateHasChanged();
                }
                else
                {
                    string errorDetails = await response.Content.ReadAsStringAsync();
                    toastService.ShowError(errorDetails);
                }
            }
            catch (Exception ex)
            {
                toastService.ShowError(ex.Message);
                Console.WriteLine($"Error fetching supplier data: {ex.Message}");
            }
        }
        public async Task AddEditCustomer()
        {
            try
            {
                customerModel.Id = CustomeID;
                var apiUrl = $"{_configuration["API_App_URL"]}/api/Customer/CreateCustomer";
                var resJson = JsonSerializer.Serialize(customerModel);
                var content = new StringContent(resJson, System.Text.Encoding.UTF8, "application/json");
                var response = new HttpResponseMessage();// await httpClient.PostAsync($"{_configuration["API_App_URL"]}/api/Products/CreateProduct", content);
                response = await httpClient.PostAsync(apiUrl, content);

                if (response == null)
                {
                    Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                    toastService.ShowError("API Response is null. Possible network error or invalid URL. ");
                    return;
                }
                if (response.IsSuccessStatusCode)
                {
                    if (CustomeID > 0)
                    {

                        NotificationService.SuccessMessage = "Customer has been updated successfully.";

                        navigator.NavigateTo("/view-customer");
                    }
                    else
                    {
                        NotificationService.SuccessMessage = "Customer has been saved successfully.";
                        // toastService.ShowSuccess("Customer has been added successfully.");
                        navigator.NavigateTo("/view-customer");
                        customerModel = new AddEditCustomerModel();
                    }

                    //navigator.NavigateTo("view-user", true);


                }

            }
            catch (Exception ex)
            {
                toastService.ShowError(ex.Message);

            }
            finally
            {
                // if (lstProducts.Count == 0)
                // {
                //     tableLabel = "No record found.";
                // }
                StateHasChanged();
            }

        }
    }
