@page "/view-user/edit-user/{UserID:long}"
    <PageTitle>Add/Edit User</PageTitle>

    @using Blazored.Toast.Services
    @using OrderPoint.Admin.Components.Common

    @using OrderPoint.Admin.Helper
    @using OrderPoint.Domain.Common
    @using OrderPoint.Domain.ViewModel
    @using Blazored.LocalStorage
    @using System.Net.Http.Headers
    @using System.Text.Json
    @using System.Text
    @inject HttpClient httpClient
    @inject NavigationManager navigator
    @inject IToastService toastService
    @rendermode InteractiveServer
    @inject Blazored.LocalStorage.ILocalStorageService _localStorage
    @inject IConfiguration _configuration
    @inject IJSRuntime JSRuntime
    @inject NotificationService NotificationService
    <div class="min-h-screen mt-3">
        <div class="">
            <div class="flex flex-wrap justify-between items-center mb-4 gap-4">
                <div class="text-2xl font-semibold text-black">
                    Edit User
                </div>
                <div class="flex flex-wrap gap-2 w-full md:w-auto items-center">
                    <a href="/view-user" class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                        <i class="fa fa-arrow-left pe-2"></i>Back To List
                    </a>
                </div>
            </div>
        </div>
        <div>
            <EditForm Model="Editusernmodel" OnValidSubmit="EditUser">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="">
                            <label class="block text-md text-[16px] text-black mb-1 ">User Type</label>
                            <input type="text" disabled class="w-full px-6 py-2 rounded-full border border-[#C4C4C4] focus:outline-none mb-4 focus:ring-[#D2D2D2]  focus:ring-1 valid" @bind-value="@Editusernmodel.UserType">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="">
                            <label class="block text-md text-[16px] text-black mb-1 ">Email Address</label>
                            <input type="text" disabled class="w-full px-6 py-2 rounded-full border border-[#C4C4C4] focus:outline-none mb-4 focus:ring-[#D2D2D2]  focus:ring-1 valid" @bind-value="@Editusernmodel.EmailAddress">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="">
                            <label class="block text-md text-[16px] text-black mb-1 ">First Name</label>
                            <input type="text" class="w-full px-6 py-2 rounded-full border border-[#C4C4C4] focus:outline-none mb-4 focus:ring-[#D2D2D2]  focus:ring-1 valid" @bind-value="@Editusernmodel.FirstName">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-2">
                            <label class="block text-md text-[16px] text-black mb-1 ">Last Name</label>
                            <input type="text" class="w-full px-6 py-2 rounded-full border border-[#C4C4C4] focus:outline-none mb-4 focus:ring-[#D2D2D2]  focus:ring-1 valid" @bind-value="@Editusernmodel.LastName">
                        </div>
                    </div>

                    <div class="col-lg-12">
                        <div class="flex justify-content-between align-items-center">
                            <a href="javascript:;" @onclick="()=>DeleteUserLinks()" class="text-danger text-hovar-danger">Delete user altogether (including links to wholesalers/customers)</a>
                            <button class="bg-[#4E4D4D] text-white px-4 py-2 rounded-full hover:bg-[#4E4D4D] flex-grow md:flex-none text-[16px] text-center">
                                Save
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @code {
        [Parameter]
        public long UserID { get; set; }
        EditUseViewModel Editusernmodel = new();
        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                string token = await _localStorage.GetItemAsync<string>("authToken");
                ///  token="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYW1lIjoiV2FxYXMiLCJyb2xlIjoiQWRtaW4iLCJleHAiOjE3MDAwMDAwMDB9.yNmvPhOG-XNhdsmnLaz6JSnq5B0hQAp8qOgADodDxqM";
                if (!string.IsNullOrEmpty(token))
                {
                    httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                    await GetUserByID();
                }
                else
                {
                    navigator.NavigateTo("/");
                }

            }
        }

        public async Task GetUserByID()
        {

            try
            {
                var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/GetAdminByID?userID={UserID}";
                var response = await httpClient.GetAsync(apiUrl);

                if (response.IsSuccessStatusCode)
                {
                    var jsonString = await response.Content.ReadAsStringAsync();
                    var result = JsonSerializer.Deserialize<Response<EditUseViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    Editusernmodel = result?.Data ?? new EditUseViewModel();
                    // adminmodel.IsEdit = true;

                    //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();
                    StateHasChanged();
                }
                else
                {
                    string errorDetails = await response.Content.ReadAsStringAsync();
                    toastService.ShowError(errorDetails);
                }
            }
            catch (Exception ex)
            {
                toastService.ShowError(ex.Message);
                Console.WriteLine($"Error fetching supplier data: {ex.Message}");
            }
        }
        public async Task EditUser()
        {
            try
            {

                var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/Updateuser";
                var resJson = JsonSerializer.Serialize(Editusernmodel);
                var content = new StringContent(resJson, System.Text.Encoding.UTF8, "application/json");
                var response = new HttpResponseMessage();// await httpClient.PostAsync($"{_configuration["API_App_URL"]}/api/Products/CreateProduct", content);
                response = await httpClient.PutAsync(apiUrl, content);

                if (response == null)
                {
                    Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                    toastService.ShowError("API Response is null. Possible network error or invalid URL. ");
                    return;
                }
                if (response.IsSuccessStatusCode)
                {
                    var jsonString = await response.Content.ReadAsStringAsync();
                    var result = JsonSerializer.Deserialize<APIResponse>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                    if (result.Success)
                    {

                        NotificationService.SuccessMessage = "User has been added successfully.";
                    }
                    else
                    {
                        //toastService.ShowError(result.Message);
                        NotificationService.ErrorMessage = result.Message;
                    }


                    navigator.NavigateTo("view-user");


                }

            }
            catch (Exception ex)
            {
                toastService.ShowError(ex.Message);

            }
            finally
            {
                // if (lstProducts.Count == 0)
                // {
                //     tableLabel = "No record found.";
                // }
                StateHasChanged();
            }

        }
        public async Task DeleteUserLinks()
        {
            //var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/Removeuser?userID={userID}&isDeleleUserForCustomer={true}";
            //var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/Removeuser?userID={userID}&isDeleleUserForWholesaler={true} ";

            try
            {
                bool confirmed = await JSRuntime.InvokeAsync<bool>("ShowConfirmSwal", "Are you sure?", "Do you want to remove this user?", "warning");
                if (confirmed)
                {


                    var apiUrl = $"{_configuration["API_App_URL"]}/api/Admin/Removeuser?userID={UserID}";
                    var response = await httpClient.GetAsync(apiUrl);

                    if (response.IsSuccessStatusCode)
                    {
                        var jsonString = await response.Content.ReadAsStringAsync();
                        var result = JsonSerializer.Deserialize<Response<SignupViewModel>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (result.Success)
                        {


                            NotificationService.SuccessMessage = "User has been Deleted successfully.";
                        }
                        else
                        {

                            NotificationService.ErrorMessage = result.Message;

                        }

                        navigator.NavigateTo("view-user");
                        //selectedProductIds = Model.CargoLists.Select(x => x.ProductId).ToList();

                    }
                    else
                    {
                        string errorDetails = await response.Content.ReadAsStringAsync();
                    }

                }
            }
            catch (Exception ex)
            {

                NotificationService.ErrorMessage = ex.Message;
                Console.WriteLine($"Error fetching supplier data: {ex.Message}");
            }
        }
    }
