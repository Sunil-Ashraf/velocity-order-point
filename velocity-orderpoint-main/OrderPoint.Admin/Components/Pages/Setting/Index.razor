@code {
    [Parameter]
    public bool loader { get; set; } = false;
    public List<SystemSetting> seetingList { get; set; }
    private bool isAuthenticated;
    private void setAuth(bool val)
    {
        if (val)
        {
            isAuthenticated = val;
            StateHasChanged();
        }
        else
        {
            navigator.NavigateTo("/", true);
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            string token = await _localStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
                await GetList();
            }
            else
            {
                navigator.NavigateTo("/");
            }

        }
    }
    private async Task GetList()
    {
        // tableLabel = "Loading...";
        try
        {

            var apiUrl = $"{_configuration["API_App_URL"]}/api/EmailTemplates/GetSystemSettingList";

            // Make the API call
            var response = await httpClient.GetAsync(apiUrl);

            if (response == null)
            {
                Console.WriteLine("❌ API Response is null. Possible network error or invalid URL.");
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<PagerResponse<SystemSetting>>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                seetingList = result?.data ?? new List<SystemSetting>();

            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"❌ API Response: {response.StatusCode}");
                if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Console.WriteLine("❌ 404 Not Found: The requested resource was not found.");
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    Console.WriteLine("❌ 401 Unauthorized: Token is invalid or expired.");
                    await _localStorage.RemoveItemAsync("authToken");
                    navigator.NavigateTo("/");
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception in GetProductData: {ex.Message}");
        }
    }
    private async Task SaveSystemSetting()
    {
        try
        {

            loader = true;
            var json = JsonSerializer.Serialize(seetingList);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = new HttpResponseMessage();
            response = await httpClient.PostAsync($"{_configuration["API_App_URL"]}/api/EmailTemplates/SaveSystemSetting", content);
            loader = false;
            if (response.IsSuccessStatusCode)
            {
                var jsonString = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<APIResponse>(jsonString, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result.Success)
                {
                    //await JSRuntime.InvokeVoidAsync("hideModal", "addEditModal");
                    toastService.ShowSuccess(result.Message);
                    //selectedUser = new();
                    await GetList();
                }
                else
                {
                    toastService.ShowError(result.Message);
                }
            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync(); // Read response body
                toastService.ShowError($"Failed to Save: {response.StatusCode}");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error saving report: {ex.Message}");
        }
    }
}
